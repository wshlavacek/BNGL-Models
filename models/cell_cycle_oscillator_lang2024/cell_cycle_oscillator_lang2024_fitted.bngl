	AsCDKN1BCCNE: @cell:CDKN1B(CCNE_A) + @cell:CCNE(CDKN1A_B) <-> @cell:CDKN1B(CCNE_A!1).CCNE(CDKN1A_B!1) kAsCdkn1bC, kDiCdkn1bC  # CDKN1B cannot form a stable complex with CCNB/Cdk1
	PhCDKN1BByCe: @cell:CDKN1B(Thr187~u) + CCNE(CDKN1A_B) -> @cell:CDKN1B(Thr187~p) + CCNE(CDKN1A_B) kPhCDKN1BByCe
	PhCDKN1BByCa: @cell:CDKN1B(Thr187~u) + CCNA(CDKN1A_B) -> @cell:CDKN1B(Thr187~p) + CCNA(CDKN1A_B) kPhCDKN1BByCa
	PhCDKN1BByCb: @cell:CDKN1B(Thr187~u) + CCNB(CDKN1A,CDK1_Thr14_Tyr15~u) -> @cell:CDKN1B(Thr187~p) + CCNB(CDKN1A,CDK1_Thr14_Tyr15~u) kPhCDKN1BByCb
	DpCDKN1B: @cell:CDKN1B(Thr187~p) -> @cell:CDKN1B(Thr187~u) kDpCDKN1B
end reaction rules

end model

begin actions

  generate_network({overwrite=>1})  # 73 species, 332 reactions

  # Two cell cycles from the PEtab wild-type condition

  #@protocol: |
  #  ODE time course from the PEtab wt initial state over the horizon of the authors'
  #  simulation output, 0 to 136471.6126 s. The authors sampled 600 non-uniform pseudotime
  #  points; this protocol uses a uniform grid finer than their smallest spacing (164.6 s),
  #  and the verification evaluates the same network on their points directly.
  #  print_functions=>1 writes the eight observation functions.

  #@figure: Fig L in S1 Appendix of Lang et al. (2024)

  simulate({method=>"ode",suffix=>"ode",t_start=>0,t_end=>136471.6126,\
    n_steps=>1200,print_functions=>1,atol=>1e-12,rtol=>1e-10})

end actions
