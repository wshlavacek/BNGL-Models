begin model

#@title: Combinatorial histone H4 acetylation (Blasi et al., 2016)

#@description: |
#  Motif-specific acetylation of the histone H4 N-terminal tail in
#  Drosophila melanogaster KC cells. Lysines K5, K8, K12 and K16 are
#  independently acetylatable, so a single H4 tail occupies one of
#  2^4 = 16 acetylation "motifs" that form the vertices of a 4-cube.
#  Stepwise acetylation and deacetylation move an H4 tail along the
#  32 edges of that cube in each direction, giving 64 unidirectional
#  mass-action reactions among 16 species.
#
#  Mathematically the model is a linear (monomolecular) reaction
#  network. Every acetylation carries a rate constant a; every
#  deacetylation carries the same unspecific rate constant d, which is
#  set to 1 so that time is measured in deacetylation lifetimes and all
#  acetylation rate constants are read as ratios to the deacetylation
#  rate. No H4 is created or destroyed, so the 16 abundances are
#  conserved and are interpreted as relative abundances summing to 1.
#  The model is therefore dimensionless and ODE-only.
#
#  This file carries the best motif-specific model of Blasi et al.
#  (2016): 25 of the 32 acetylation reactions run at the basal rate
#  a_b = 0.0668, while seven run at motif-specific rates estimated by
#  maximum likelihood (Table S1). Three of those seven exceed the
#  deacetylation rate (K5 -> K5K12, K12K16 -> K8K12K16 and
#  K8K12K16 -> 4ac), the signature of dedicated acetylation pathways.
#
#  Dynamics: from unmodified H4 the network relaxes monotonically to a
#  unique steady state within a few deacetylation lifetimes. Because
#  acetylation is slower than deacetylation on most edges, abundance
#  falls steeply with the number of acetyl marks: 0ac holds 73.8% of
#  H4, the four singly acetylated motifs 3-7% each, and the fully
#  acetylated 4ac motif 0.3%. The motif-specific rates break the
#  within-layer symmetry that a purely unspecific model would impose,
#  spreading the doubly acetylated motifs over an order of magnitude
#  (K5K12 at 4.8% against K5K16 at 0.39%) and reproducing all 15
#  measured motif abundances.

#@keyword: |
#  chromatin, histone acetylation, post-translational modification,
#  combinatorial modification, epigenetics, mass action, linear
#  reaction network, steady state, dimensionless, Drosophila
#  melanogaster

#@reference: |
#  Blasi T, Feller C, Feigelman J, Hasenauer J, Imhof A, Theis FJ,
#  Becker PB, Marr C (2016). Combinatorial histone acetylation patterns
#  are generated by motif-specific reactions. Cell Systems 2:49-58.
#  doi:10.1016/j.cels.2016.01.002
#  Feller C, Forne I, Imhof A, Becker PB (2015). Global and specific
#  responses of the histone acetylome to systematic perturbation.
#  Molecular Cell 57:559-571. doi:10.1016/j.molcel.2014.12.008

begin parameters

  #@note: |
  #  Dimensionless units. Abundances are fractions of the total H4 pool
  #  (they sum to 1), and time is in units of the deacetylation
  #  lifetime 1/d. Every acetylation rate constant is therefore the
  #  ratio of that acetylation rate to the deacetylation rate; a value
  #  above 1 marks an edge on which acetylation outruns deacetylation.

  # Unspecific deacetylation rate constant, shared by all 32
  # deacetylation reactions and fixed at 1 to set the time unit;
  # see Supplemental Experimental Procedures section 3, assumption 2,
  # in Blasi et al. (2016)
  d                  1.0     # dimensionless

  # Basal acetylation rate constant, used by the 25 acetylation
  # reactions that are not motif-specific; see Table S1 in Blasi et al.
  # (2016)
  a_b                0.0668  # dimensionless

  #@note: |
  #  The seven motif-specific acetylation rate constants of the best
  #  motif-specific model, named for the edge they act on. Values are
  #  the maximum-likelihood estimates of Table S1 in Blasi et al.
  #  (2016), reported to four digits in the rank-1 row of Table S2.
  #  95% profile-likelihood confidence intervals from Table S1:
  #    a_b                 [0.063, 0.071]
  #    a_0ac_K8            [0.022, 0.033]
  #    a_K5_K5K12          [1.714, 2.500]
  #    a_K12_K5K12         [0.419, 0.705]
  #    a_K16_K12K16        [0.595, 0.813]
  #    a_K5K12_K5K8K12     [0.273, 0.387]
  #    a_K12K16_K8K12K16   [1.914, 2.542]
  #    a_K8K12K16_4ac      [3.102, 4.154]

  a_0ac_K8           0.0273  # dimensionless
  a_K5_K5K12         2.062   # dimensionless
  a_K12_K5K12        0.5519  # dimensionless
  a_K16_K12K16       0.6959  # dimensionless
  a_K5K12_K5K8K12    0.3253  # dimensionless
  a_K12K16_K8K12K16  2.2055  # dimensionless
  a_K8K12K16_4ac     3.5917  # dimensionless
end parameters

begin molecule types
  # Histone H4 N-terminal tail (residues G4-R17), carrying the four
  # acetylatable lysines that define the motif; the Drosophila
  # melanogaster genes are the His4 family (FlyBase)
  H4(k5~0~ac,k8~0~ac,k12~0~ac,k16~0~ac)
end molecule types

begin seed species
  # All H4 starts unmodified (motif 0ac); the total is normalized to 1
  H4(k5~0,k8~0,k12~0,k16~0)  1  # dimensionless
end seed species

begin observables

  #@note: |
  #  One observable per acetylation motif, named as in Figs. 1B and 2
  #  of Blasi et al. (2016). Each pattern fixes all four lysine states,
  #  so each observable resolves exactly one of the 16 species.

  # Layer 0: unmodified
  Species  Obs_0ac       H4(k5~0,k8~0,k12~0,k16~0)

  # Layer 1: singly acetylated
  Species  Obs_K5        H4(k5~ac,k8~0,k12~0,k16~0)
  Species  Obs_K8        H4(k5~0,k8~ac,k12~0,k16~0)
  Species  Obs_K12       H4(k5~0,k8~0,k12~ac,k16~0)
  Species  Obs_K16       H4(k5~0,k8~0,k12~0,k16~ac)

  # Layer 2: doubly acetylated
  Species  Obs_K5K8      H4(k5~ac,k8~ac,k12~0,k16~0)
  Species  Obs_K5K12     H4(k5~ac,k8~0,k12~ac,k16~0)
  Species  Obs_K5K16     H4(k5~ac,k8~0,k12~0,k16~ac)
  Species  Obs_K8K12     H4(k5~0,k8~ac,k12~ac,k16~0)
  Species  Obs_K8K16     H4(k5~0,k8~ac,k12~0,k16~ac)
  Species  Obs_K12K16    H4(k5~0,k8~0,k12~ac,k16~ac)

  # Layer 3: triply acetylated
  Species  Obs_K5K8K12   H4(k5~ac,k8~ac,k12~ac,k16~0)
  Species  Obs_K5K8K16   H4(k5~ac,k8~ac,k12~0,k16~ac)
  Species  Obs_K5K12K16  H4(k5~ac,k8~0,k12~ac,k16~ac)
  Species  Obs_K8K12K16  H4(k5~0,k8~ac,k12~ac,k16~ac)

  # Layer 4: fully acetylated
  Species  Obs_4ac       H4(k5~ac,k8~ac,k12~ac,k16~ac)

  # Conservation check: the total H4 pool is closed and stays at 1
  Molecules  Obs_Tot_H4     H4()
  # Mean number of acetyl marks per H4 tail, i.e. the layer index
  # averaged over the motif distribution
  Molecules  Obs_Ac_Marks   H4(k5~ac) H4(k8~ac) H4(k12~ac) H4(k16~ac)
end observables

begin reaction rules

  #@note: |
  #  The 32 acetylation edges are partitioned by the state of the
  #  lysines that are not being acetylated, so that each edge is
  #  generated by exactly one rule. Eleven basal rules cover the 25
  #  unspecific edges and seven single-edge rules carry the
  #  motif-specific rate constants. BioNetGen sums the rates of rules
  #  that generate the same reaction, so the partition — not a rule
  #  ordering — is what keeps each edge at a single rate.

  # K5 acetylation: basal unless K12 alone is acetylated (K5K12
  # genesis) or all three neighbors are acetylated (4ac genesis)
  R_ac_k5_basal_k12u:   H4(k5~0,k12~0) -> H4(k5~ac,k12~0)  a_b
  R_ac_k5_basal_K8K12:  H4(k5~0,k8~ac,k12~ac,k16~0) -> \
    H4(k5~ac,k8~ac,k12~ac,k16~0)  a_b
  R_ac_k5_basal_K12K16: H4(k5~0,k8~0,k12~ac,k16~ac) -> \
    H4(k5~ac,k8~0,k12~ac,k16~ac)  a_b

  # Motif-specific: K12 -> K5K12, the second step of the HAT1 pathway
  R_ac_k5_K12: H4(k5~0,k8~0,k12~ac,k16~0) -> \
    H4(k5~ac,k8~0,k12~ac,k16~0)  a_K12_K5K12

  # Motif-specific: K8K12K16 -> 4ac, the final step of the K16 zipper
  R_ac_k5_K8K12K16: H4(k5~0,k8~ac,k12~ac,k16~ac) -> \
    H4(k5~ac,k8~ac,k12~ac,k16~ac)  a_K8K12K16_4ac

  # K8 acetylation: basal on five edges
  R_ac_k8_basal_K5u:    H4(k5~ac,k8~0,k12~0) -> H4(k5~ac,k8~ac,k12~0)  a_b
  R_ac_k8_basal_K12:    H4(k5~0,k8~0,k12~ac,k16~0) -> \
    H4(k5~0,k8~ac,k12~ac,k16~0)  a_b
  R_ac_k8_basal_K16:    H4(k5~0,k8~0,k12~0,k16~ac) -> \
    H4(k5~0,k8~ac,k12~0,k16~ac)  a_b
  R_ac_k8_basal_K5K12K16: H4(k5~ac,k8~0,k12~ac,k16~ac) -> \
    H4(k5~ac,k8~ac,k12~ac,k16~ac)  a_b

  # Motif-specific: 0ac -> K8, the only motif-specific rate slower than
  # basal, which suppresses the singly acetylated K8 motif
  R_ac_k8_0ac: H4(k5~0,k8~0,k12~0,k16~0) -> \
    H4(k5~0,k8~ac,k12~0,k16~0)  a_0ac_K8

  # Motif-specific: K5K12 -> K5K8K12, the third step of the HAT1 pathway
  R_ac_k8_K5K12: H4(k5~ac,k8~0,k12~ac,k16~0) -> \
    H4(k5~ac,k8~ac,k12~ac,k16~0)  a_K5K12_K5K8K12

  # Motif-specific: K12K16 -> K8K12K16, the second step of the K16 zipper
  R_ac_k8_K12K16: H4(k5~0,k8~0,k12~ac,k16~ac) -> \
    H4(k5~0,k8~ac,k12~ac,k16~ac)  a_K12K16_K8K12K16

  # K12 acetylation: basal whenever K8 is already acetylated, plus two
  # further unspecific edges
  R_ac_k12_basal_K8ac:  H4(k8~ac,k12~0) -> H4(k8~ac,k12~ac)  a_b
  R_ac_k12_basal_0ac:   H4(k5~0,k8~0,k12~0,k16~0) -> \
    H4(k5~0,k8~0,k12~ac,k16~0)  a_b
  R_ac_k12_basal_K5K16: H4(k5~ac,k8~0,k12~0,k16~ac) -> \
    H4(k5~ac,k8~0,k12~ac,k16~ac)  a_b

  # Motif-specific: K5 -> K5K12, the first committed step of the HAT1
  # pathway and the fastest acetylation out of a singly acetylated motif
  R_ac_k12_K5: H4(k5~ac,k8~0,k12~0,k16~0) -> \
    H4(k5~ac,k8~0,k12~ac,k16~0)  a_K5_K5K12

  # Motif-specific: K16 -> K12K16, the first step of the K16 zipper
  R_ac_k12_K16: H4(k5~0,k8~0,k12~0,k16~ac) -> \
    H4(k5~0,k8~0,k12~ac,k16~ac)  a_K16_K12K16

  # K16 acetylation is basal in every context; no K16 edge was selected
  # as motif-specific
  R_ac_k16_basal: H4(k16~0) -> H4(k16~ac)  a_b

  # Unspecific deacetylation of each site, independent of the motif
  R_deac_k5:  H4(k5~ac) -> H4(k5~0)    d
  R_deac_k8:  H4(k8~ac) -> H4(k8~0)    d
  R_deac_k12: H4(k12~ac) -> H4(k12~0)  d
  R_deac_k16: H4(k16~ac) -> H4(k16~0)  d
end reaction rules

end model

begin actions
  generate_network({overwrite=>1})  # 16 species, 64 reactions

  # Relaxation to the steady-state motif distribution

  #@protocol: |
  #  Start from unmodified H4 and integrate to t = 50 deacetylation
  #  lifetimes, far beyond the slowest relaxation mode of the network
  #  (time constant about 0.9). The measured LC-MS abundances are
  #  assumed to be stationary, so the endpoint of this trajectory is
  #  the quantity compared with the data. Expected endpoint: 0ac at
  #  0.7376, K5K12 the largest doubly acetylated motif at 0.0480, 4ac
  #  at 0.00319, Obs_Tot_H4 held at 1 and Obs_Ac_Marks settling at
  #  0.3766 acetyl marks per tail.

  #@figure: Fig. 2C in Blasi et al. (2016)

  simulate({method=>"ode",suffix=>"ode",t_start=>0,t_end=>50,n_steps=>500,\
    atol=>1e-12,rtol=>1e-10})
end actions
