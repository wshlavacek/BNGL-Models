begin model

#@title: Combinatorial histone H4 acetylation, site-specific scenario (Blasi et al., 2016)

#@description: |
#  Site-specific acetylation scenario of Blasi et al. (2016), the
#  intermediate of the three hypotheses tested against the histone H4
#  motif abundances of Drosophila melanogaster KC cells. Each lysine
#  carries its own acetylation rate constant, but that constant is the
#  same in every modification context, so the acetylation rate at a
#  site never depends on which neighbors are already acetylated.
#
#  This is the best of the 11 site-specific models the paper
#  enumerated: all four sites are given distinct rates, which the BIC
#  prefers over any model that leaves one or more sites at a shared
#  basal rate. In rule form it is still one acetylation rule and one
#  deacetylation rule per site, exactly as in the unspecific variant;
#  only the four rate constants differ. The generated network remains
#  16 species and 64 unidirectional reactions.
#
#  Dynamics: because no rate depends on context, the four sites are
#  statistically independent two-state systems and the steady state
#  factorizes, x_m = prod over acetylated sites of a_s/(1 + a_s) times
#  prod over unmodified sites of 1/(1 + a_s). Motifs within a layer
#  are therefore no longer degenerate — K12 reaches 0.1927 against
#  0.0495 for K16 — which halves the number of measurements the model
#  fails to explain relative to the unspecific scenario (7 of 15
#  outside the 95% confidence intervals, BIC 644.5 against 697.3).
#  What the factorization cannot produce is the strong coupling seen
#  in the data, most visibly K5K12 at 4.8% of H4, which needs the
#  motif-specific rates of the primary model.

#@keyword: |
#  chromatin, histone acetylation, post-translational modification,
#  combinatorial modification, epigenetics, mass action, linear
#  reaction network, steady state, model selection, dimensionless,
#  Drosophila melanogaster

#@reference: |
#  Blasi T, Feller C, Feigelman J, Hasenauer J, Imhof A, Theis FJ,
#  Becker PB, Marr C (2016). Combinatorial histone acetylation patterns
#  are generated by motif-specific reactions. Cell Systems 2:49-58.
#  doi:10.1016/j.cels.2016.01.002

begin parameters

  #@note: |
  #  Dimensionless units, as in the primary model: abundances are
  #  fractions of the total H4 pool and time is in units of the
  #  deacetylation lifetime 1/d.

  # Unspecific deacetylation rate constant, fixed at 1 to set the time
  # unit
  d      1.0    # dimensionless

  #@note: |
  #  Site-specific acetylation rate constants of the best site-specific
  #  model, with 95% profile-likelihood confidence intervals from the
  #  Results of Blasi et al. (2016):
  #    a_K5   [0.181, 0.280]
  #    a_K8   [0.104, 0.154]
  #    a_K12  [0.331, 0.528]
  #    a_K16  [0.088, 0.131]
  #  All four are below 1, so deacetylation outruns acetylation at
  #  every site.

  a_K5   0.225  # dimensionless
  a_K8   0.126  # dimensionless
  a_K12  0.417  # dimensionless
  a_K16  0.107  # dimensionless
end parameters

begin molecule types
  # Histone H4 N-terminal tail (residues G4-R17), carrying the four
  # acetylatable lysines that define the motif
  H4(k5~0~ac,k8~0~ac,k12~0~ac,k16~0~ac)
end molecule types

begin seed species
  # All H4 starts unmodified (motif 0ac); the total is normalized to 1
  H4(k5~0,k8~0,k12~0,k16~0)  1  # dimensionless
end seed species

begin observables

  #@note: |
  #  One observable per acetylation motif, named as in Figs. 1B and 2
  #  of Blasi et al. (2016), so that output columns line up with the
  #  primary model.

  # Layer 0: unmodified
  Species  Obs_0ac       H4(k5~0,k8~0,k12~0,k16~0)

  # Layer 1: singly acetylated
  Species  Obs_K5        H4(k5~ac,k8~0,k12~0,k16~0)
  Species  Obs_K8        H4(k5~0,k8~ac,k12~0,k16~0)
  Species  Obs_K12       H4(k5~0,k8~0,k12~ac,k16~0)
  Species  Obs_K16       H4(k5~0,k8~0,k12~0,k16~ac)

  # Layer 2: doubly acetylated
  Species  Obs_K5K8      H4(k5~ac,k8~ac,k12~0,k16~0)
  Species  Obs_K5K12     H4(k5~ac,k8~0,k12~ac,k16~0)
  Species  Obs_K5K16     H4(k5~ac,k8~0,k12~0,k16~ac)
  Species  Obs_K8K12     H4(k5~0,k8~ac,k12~ac,k16~0)
  Species  Obs_K8K16     H4(k5~0,k8~ac,k12~0,k16~ac)
  Species  Obs_K12K16    H4(k5~0,k8~0,k12~ac,k16~ac)

  # Layer 3: triply acetylated
  Species  Obs_K5K8K12   H4(k5~ac,k8~ac,k12~ac,k16~0)
  Species  Obs_K5K8K16   H4(k5~ac,k8~ac,k12~0,k16~ac)
  Species  Obs_K5K12K16  H4(k5~ac,k8~0,k12~ac,k16~ac)
  Species  Obs_K8K12K16  H4(k5~0,k8~ac,k12~ac,k16~ac)

  # Layer 4: fully acetylated
  Species  Obs_4ac       H4(k5~ac,k8~ac,k12~ac,k16~ac)

  # Conservation check: the total H4 pool is closed and stays at 1
  Molecules  Obs_Tot_H4     H4()
  # Mean number of acetyl marks per H4 tail
  Molecules  Obs_Ac_Marks   H4(k5~ac) H4(k8~ac) H4(k12~ac) H4(k16~ac)
end observables

begin reaction rules

  #@note: |
  #  As in the unspecific variant, no pattern names a neighboring
  #  lysine, so each rule matches all eight contexts of its site. The
  #  only change is that the four acetylation rules now carry four
  #  different rate constants.

  # Site-specific acetylation, context-independent
  R_ac_k5:  H4(k5~0) -> H4(k5~ac)    a_K5
  R_ac_k8:  H4(k8~0) -> H4(k8~ac)    a_K8
  R_ac_k12: H4(k12~0) -> H4(k12~ac)  a_K12
  R_ac_k16: H4(k16~0) -> H4(k16~ac)  a_K16

  # Unspecific deacetylation of each site
  R_deac_k5:  H4(k5~ac) -> H4(k5~0)    d
  R_deac_k8:  H4(k8~ac) -> H4(k8~0)    d
  R_deac_k12: H4(k12~ac) -> H4(k12~0)  d
  R_deac_k16: H4(k16~ac) -> H4(k16~0)  d
end reaction rules

end model

begin actions
  generate_network({overwrite=>1})  # 16 species, 64 reactions

  # Relaxation to the steady-state motif distribution

  #@protocol: |
  #  Start from unmodified H4 and integrate to t = 50 deacetylation
  #  lifetimes. Expected endpoint: 0ac at 0.4622, K12 the largest
  #  singly acetylated motif at 0.1927, K5K12 the largest doubly
  #  acetylated motif at 0.0434, 4ac at 0.000585, Obs_Tot_H4 held at 1
  #  and Obs_Ac_Marks at 0.6865. Each motif abundance should equal the
  #  product of its four per-site factors.

  #@figure: Fig. 2B in Blasi et al. (2016)

  simulate({method=>"ode",suffix=>"ode",t_start=>0,t_end=>50,n_steps=>500,\
    atol=>1e-12,rtol=>1e-10})
end actions
