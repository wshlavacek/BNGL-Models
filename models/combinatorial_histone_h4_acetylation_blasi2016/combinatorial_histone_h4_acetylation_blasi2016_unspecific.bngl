begin model

#@title: Combinatorial histone H4 acetylation, unspecific scenario (Blasi et al., 2016)

#@description: |
#  Unspecific acetylation scenario of Blasi et al. (2016), the simplest
#  of the three hypotheses tested against the histone H4 motif
#  abundances of Drosophila melanogaster KC cells. It differs from the
#  primary motif-specific model only in the acetylation rate constants:
#  every one of the 32 acetylation edges of the 4-cube runs at the same
#  basal rate a_b, so a single parameter governs the whole network.
#
#  Because no lysine and no modification context is distinguished, the
#  rule set collapses to one acetylation rule and one deacetylation
#  rule per site. The generated network is still the same 16 species
#  and 64 unidirectional reactions.
#
#  Dynamics: with all edges equal, the steady state depends only on the
#  number of acetyl marks, so all motifs in a layer share an abundance:
#  x = a_b^k / (1 + a_b)^4 for a motif with k marks. With the
#  maximum-likelihood estimate a_b = 0.182 that gives 0.5123 for 0ac,
#  0.0932 for each singly acetylated motif, 0.0170 for each doubly,
#  0.00309 for each triply and 0.000562 for 4ac. The bias toward
#  deacetylation captures the overall decline of abundance with
#  acetylation level, but the enforced within-layer degeneracy is what
#  the data reject: 13 of the 15 measured motif abundances fall outside
#  the model's 95% confidence intervals, and its BIC of 697.3 is worse
#  than the motif-specific model's by 630.

#@keyword: |
#  chromatin, histone acetylation, post-translational modification,
#  combinatorial modification, epigenetics, mass action, linear
#  reaction network, steady state, model selection, dimensionless,
#  Drosophila melanogaster

#@reference: |
#  Blasi T, Feller C, Feigelman J, Hasenauer J, Imhof A, Theis FJ,
#  Becker PB, Marr C (2016). Combinatorial histone acetylation patterns
#  are generated by motif-specific reactions. Cell Systems 2:49-58.
#  doi:10.1016/j.cels.2016.01.002

begin parameters

  #@note: |
  #  Dimensionless units, as in the primary model: abundances are
  #  fractions of the total H4 pool and time is in units of the
  #  deacetylation lifetime 1/d.

  # Unspecific deacetylation rate constant, fixed at 1 to set the time
  # unit
  d    1.0    # dimensionless

  # The single basal acetylation rate constant shared by all 32
  # acetylation reactions; maximum-likelihood estimate with 95%
  # profile-likelihood confidence interval [0.170, 0.195], reported in
  # the Results of Blasi et al. (2016)
  a_b  0.182  # dimensionless
end parameters

begin molecule types
  # Histone H4 N-terminal tail (residues G4-R17), carrying the four
  # acetylatable lysines that define the motif
  H4(k5~0~ac,k8~0~ac,k12~0~ac,k16~0~ac)
end molecule types

begin seed species
  # All H4 starts unmodified (motif 0ac); the total is normalized to 1
  H4(k5~0,k8~0,k12~0,k16~0)  1  # dimensionless
end seed species

begin observables

  #@note: |
  #  One observable per acetylation motif, named as in Figs. 1B and 2
  #  of Blasi et al. (2016), so that output columns line up with the
  #  primary model.

  # Layer 0: unmodified
  Species  Obs_0ac       H4(k5~0,k8~0,k12~0,k16~0)

  # Layer 1: singly acetylated
  Species  Obs_K5        H4(k5~ac,k8~0,k12~0,k16~0)
  Species  Obs_K8        H4(k5~0,k8~ac,k12~0,k16~0)
  Species  Obs_K12       H4(k5~0,k8~0,k12~ac,k16~0)
  Species  Obs_K16       H4(k5~0,k8~0,k12~0,k16~ac)

  # Layer 2: doubly acetylated
  Species  Obs_K5K8      H4(k5~ac,k8~ac,k12~0,k16~0)
  Species  Obs_K5K12     H4(k5~ac,k8~0,k12~ac,k16~0)
  Species  Obs_K5K16     H4(k5~ac,k8~0,k12~0,k16~ac)
  Species  Obs_K8K12     H4(k5~0,k8~ac,k12~ac,k16~0)
  Species  Obs_K8K16     H4(k5~0,k8~ac,k12~0,k16~ac)
  Species  Obs_K12K16    H4(k5~0,k8~0,k12~ac,k16~ac)

  # Layer 3: triply acetylated
  Species  Obs_K5K8K12   H4(k5~ac,k8~ac,k12~ac,k16~0)
  Species  Obs_K5K8K16   H4(k5~ac,k8~ac,k12~0,k16~ac)
  Species  Obs_K5K12K16  H4(k5~ac,k8~0,k12~ac,k16~ac)
  Species  Obs_K8K12K16  H4(k5~0,k8~ac,k12~ac,k16~ac)

  # Layer 4: fully acetylated
  Species  Obs_4ac       H4(k5~ac,k8~ac,k12~ac,k16~ac)

  # Conservation check: the total H4 pool is closed and stays at 1
  Molecules  Obs_Tot_H4     H4()
  # Mean number of acetyl marks per H4 tail
  Molecules  Obs_Ac_Marks   H4(k5~ac) H4(k8~ac) H4(k12~ac) H4(k16~ac)
end observables

begin reaction rules

  #@note: |
  #  No pattern names a neighboring lysine, so each rule matches all
  #  eight contexts of its site. Four acetylation rules therefore cover
  #  all 32 acetylation edges at the single rate a_b. This is the whole
  #  content of the unspecific hypothesis, and the contrast with the
  #  primary model's 18 acetylation rules is the contrast between
  #  Figs. 2A and 2C in Blasi et al. (2016).

  # Unspecific acetylation of each site
  R_ac_k5:  H4(k5~0) -> H4(k5~ac)    a_b
  R_ac_k8:  H4(k8~0) -> H4(k8~ac)    a_b
  R_ac_k12: H4(k12~0) -> H4(k12~ac)  a_b
  R_ac_k16: H4(k16~0) -> H4(k16~ac)  a_b

  # Unspecific deacetylation of each site
  R_deac_k5:  H4(k5~ac) -> H4(k5~0)    d
  R_deac_k8:  H4(k8~ac) -> H4(k8~0)    d
  R_deac_k12: H4(k12~ac) -> H4(k12~0)  d
  R_deac_k16: H4(k16~ac) -> H4(k16~0)  d
end reaction rules

end model

begin actions
  generate_network({overwrite=>1})  # 16 species, 64 reactions

  # Relaxation to the steady-state motif distribution

  #@protocol: |
  #  Start from unmodified H4 and integrate to t = 50 deacetylation
  #  lifetimes. Expected endpoint: 0ac at 0.5123, every singly
  #  acetylated motif at 0.0932, every doubly acetylated motif at
  #  0.0170, every triply acetylated motif at 0.00309, 4ac at
  #  0.000562, Obs_Tot_H4 held at 1 and Obs_Ac_Marks at 0.6159. The
  #  exact degeneracy within each layer is the point of the panel.

  #@figure: Fig. 2A in Blasi et al. (2016)

  simulate({method=>"ode",suffix=>"ode",t_start=>0,t_end=>50,n_steps=>500,\
    atol=>1e-12,rtol=>1e-10})
end actions
