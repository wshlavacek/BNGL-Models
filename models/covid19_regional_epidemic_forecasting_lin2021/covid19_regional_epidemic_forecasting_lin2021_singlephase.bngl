begin model

#@title: COVID-19 regional epidemic forecasting, single-phase (Lin et al., 2021)

#@description: |
#  Single-phase (n=0) variant of the Lin et al. (2021) regional COVID-19
#  compartmental model, parameterized for the New York City metropolitan
#  statistical area (New York-Newark-Jersey City, NY-NJ-PA). This is the form the
#  paper actually fits to NYC (Lin et al. 2021 Fig 3 is conditioned on n=0) and
#  the per-MSA form of Mallela et al. (2023): one social-distancing period only
#  (setpoint p0, timescale 1/lambda0), switched on at a fixed onset sigma. The
#  compartment structure is identical to the two-phase primary --
#  S -> E1..E5 -> A / I -> H -> R / D with mixing (M), protected (P), and
#  quarantined (Q) behavioral states -- but this variant additionally includes an
#  H -> D death transition (the primary omits it), and the counter() clock seeds
#  at 0 (so the observable t equals the simulation time). The fit observable is
#  CumNum_detected_cases_Cum(), a detected-case count scaled by the detection
#  fraction fD; its day-to-day increment is the daily new-case forecast.
#  Behavior: with only one social-distancing phase the model captures the initial
#  growth and turnover but overshoots the NYC peak (~22,500 vs ~15,900 cases/day)
#  and cannot hold the broad plateau -- exactly why the published NYC forecast and
#  the two-phase primary are preferred.

#@keyword: |
#  epidemiology, COVID-19, SARS-CoV-2, compartmental model, SEIR, social
#  distancing, quarantine, non-exponential incubation, Erlang, mass action,
#  forecasting, Homo sapiens

#@reference: |
#  Lin YT, Neumann J, Miller EF, Posner RG, Mallela A, Safta C, Ray J, Thakur G,
#  Chinthavali S, Hlavacek WS (2021). Daily Forecasting of Regional Epidemics of
#  Coronavirus Disease with Bayesian Uncertainty Quantification, United States.
#  Emerg Infect Dis 27(3):767-778. doi:10.3201/eid2703.203364 -- the model and the
#  single-phase (n=0) NYC fit (Fig 3).
#  Mallela A, Lin YT, Hlavacek WS (2023). Differential contagiousness of
#  respiratory disease across the United States. Epidemics 45:100718.
#  doi:10.1016/j.epidem.2023.100718 -- the single-phase per-MSA form this variant
#  follows.

#@note: |
#  PROVENANCE. Structure, functions, and rules are the authors' PyBioNetFit model
#  (Mallela et al. 2023 DataS1 / New York-Newark-Jersey City), house-styled and
#  cleaned (four inert never-produced molecules IQ/HQ/RQ/DQ from the source file
#  are dropped; they were seeded at 0 with no rules). S0 is CORRECTED to NYC's
#  2019 census population: the shipped DataS1 file carried a placeholder S0
#  (4,903,185 = Alabama's population, identical across every shipped MSA), so its
#  shipped MLE_params.txt does not reproduce the data. The fitted-parameter
#  nominals here are an independent PyBNF differential-evolution best fit at the
#  corrected S0 (not the non-reproducing shipped MLE). Adapted from the validated
#  pybnf-jobs/Lin-2021/nyc job. See the two-phase primary
#  covid19_regional_epidemic_forecasting_lin2021.bngl.
#
#  UNITS. Populations are counts of individuals; the model is inherently
#  population-based (no molar concentration), so no NA / reference-volume
#  conversion applies. ODE-only (see the actions-block note).

begin parameters

  # Reporting period for daily incidence
  delta_t 1 # d
  # Number of ADDITIONAL social-distancing periods (n+1 total); n=0 = single phase
  n 0 # dimensionless

  # === Fitted parameters: independent PyBNF de best fit at the corrected S0 ===
  # Start time of the regional epidemic (model day 0 = 2020-01-21)
  t0 26.633393 # d
  # Onset of social distancing (fixed; ~2020-03-24, NY "PAUSE" order)
  sigma 63 # d
  # Steady-state social-distancing setpoint
  p0 0.591675 # dimensionless
  # Social-distancing relaxation eigenvalue
  lambda0 9.160433 # /d
  # Transmission rate constant (mixing population)
  beta 0.537913 # /d
  # Fraction of mild symptomatic cases detected
  fD 0.883484 # dimensionless

  # === Fixed parameters (Lin et al. 2021 Tables 2-3) ===
  # Total NYC-MSA (NY-NJ-PA) population (2019 census estimate; corrected)
  S0 19216182 # individuals
  # Initial mildly symptomatic infected
  I0 1 # individuals
  # Protective effect of social distancing
  mb 0.1 # dimensionless
  # Relative infectiousness of E (presymptomatic) vs I
  rhoE 1.1 # dimensionless
  # Relative infectiousness of A (asymptomatic) vs I
  rhoA 0.9 # dimensionless
  # Incubation-stage progression rate (5-stage Erlang)
  kL 0.94 # /d
  # Quarantine rate (testing / contact tracing)
  kQ 0.0038 # /d
  # Self-isolation rate (symptom awareness)
  jQ 0.4 # /d
  # Fraction of exposed who never develop symptoms
  fA 0.44 # dimensionless
  # Fraction of symptomatic progressing to severe / hospitalization
  fH 0.054 # dimensionless
  # Fraction of hospitalized who recover
  fR 0.79 # dimensionless
  # A -> R clearance rate
  cA 0.26 # /d
  # I -> H or I -> R rate
  cI 0.12 # /d
  # H -> R or H -> D rate
  cH 0.17 # /d

end parameters

begin molecule types

  # Cumulative detected-case counter (integral of the detection rate)
  fDCS()
  # Simulation clock: 0->counter() at rate 1; observable t = counter (seeds at 0)
  counter()
  # Susceptible; M = mixing, P = protected
  S(state~M~P)
  # Incubation stages 1-5 (non-exponential Erlang latency); Q = quarantined
  E1(state~M~P)
  E2(state~M~P~Q)
  E3(state~M~P~Q)
  E4(state~M~P~Q)
  E5(state~M~P~Q)
  # Asymptomatic infectious
  A(state~M~P~Q)
  # Mildly symptomatic infectious
  I(state~M~P~Q)
  # Hospitalized / severe
  H()
  # Recovered
  R()
  # Deceased
  D()

end molecule types

begin seed species

  fDCS() 0 # individuals
  counter() 0 # dimensionless
  S(state~M) S0 # individuals
  I(state~M) I0 # individuals

end seed species

begin observables

  # Cumulative detected symptomatic cases (detection-rate integral)
  Molecules fDCS_Cum fDCS()
  # Susceptibles by behavioral state
  Molecules SM S(state~M)
  Molecules SP S(state~P)
  Molecules nStotal S()
  # Incubation-stage populations used by the force of infection and detection
  Molecules E1M E1(state~M)
  Molecules E1P E1(state~P)
  Molecules E2M E2(state~M)
  Molecules E2P E2(state~P)
  Molecules E2to5M E2(state~M) E3(state~M) E4(state~M) E5(state~M)
  Molecules E2to5P E2(state~P) E3(state~P) E4(state~P) E5(state~P)
  Molecules E2to5Q E2(state~Q) E3(state~Q) E4(state~Q) E5(state~Q)
  Molecules nE2_MP E2(state~M) E2(state~P)
  Molecules nE3_MP E3(state~M) E3(state~P)
  Molecules nE4_MP E4(state~M) E4(state~P)
  Molecules nE5_MP E5(state~M) E5(state~P)
  # Infectious populations
  Molecules IM I(state~M)
  Molecules IP I(state~P)
  Molecules IQobs I(state~Q)
  Molecules AM A(state~M)
  Molecules AP A(state~P)
  Molecules AQ A(state~Q)
  # Outcomes and the simulation clock
  Molecules H H()
  Molecules R R()
  Molecules D D()
  Molecules t counter()

end observables

begin functions

  # Epidemic / social-distancing switches (single phase)
  U()=if(t>sigma,1,0)
  Lambda()=if(t>=sigma,lambda0,0)
  P()=if(t>=sigma,p0,0)
  # Quarantine / self-isolation / clearance switched on at t0 (mixing branch)
  kQfunc()=if(t>t0,kQ,0)
  jQfunc()=if(t>t0,jQ,0)
  cIfunc()=if(t>t0,cI,0)
  # Force of infection contributions
  phiM()=if(t>t0,IM+rhoE*E2to5M+rhoA*AM,0)
  phiP()=IP+rhoE*E2to5P+rhoA*AP
  # Fit observable: detected-case count (snapshot form scaled by fD)
  CumNum_detected_cases_Cum()=fD*(IM+IP+IQobs+H+(1-fA)*R+D)

end functions

begin reaction rules

  # Cumulative detected symptomatic cases (integral of the detection rate)
  0->fDCS() fD*(1-fA)*kL*nE5_MP
  # Simulation clock
  0->counter() 1

  # Disease transmission (mass-action force of infection on susceptibles)
  S(state~M)->E1(state~M) (beta/S0)*(phiM()+mb*phiP())
  S(state~P)->E1(state~P) mb*(beta/S0)*(phiM()+mb*phiP())

  # Social distancing: mixing <-> protected
  S(state~M)<->S(state~P) U()*Lambda()*P(),U()*Lambda()*(1-P())
  E1(state~M)<->E1(state~P) U()*Lambda()*P(),U()*Lambda()*(1-P())
  E2(state~M)<->E2(state~P) U()*Lambda()*P(),U()*Lambda()*(1-P())
  E3(state~M)<->E3(state~P) U()*Lambda()*P(),U()*Lambda()*(1-P())
  E4(state~M)<->E4(state~P) U()*Lambda()*P(),U()*Lambda()*(1-P())
  E5(state~M)<->E5(state~P) U()*Lambda()*P(),U()*Lambda()*(1-P())
  A(state~M)<->A(state~P) U()*Lambda()*P(),U()*Lambda()*(1-P())
  I(state~M)<->I(state~P) U()*Lambda()*P(),U()*Lambda()*(1-P())

  # Quarantine (testing / contact tracing)
  E2(state~M)->E2(state~Q) kQ
  E2(state~P)->E2(state~Q) kQ
  E3(state~M)->E3(state~Q) kQ
  E3(state~P)->E3(state~Q) kQ
  E4(state~M)->E4(state~Q) kQ
  E4(state~P)->E4(state~Q) kQ
  E5(state~M)->E5(state~Q) kQ
  E5(state~P)->E5(state~Q) kQ
  A(state~M)->A(state~Q) kQ
  A(state~P)->A(state~Q) kQ
  I(state~M)->I(state~Q) kQfunc()
  I(state~P)->I(state~Q) kQ

  # Self-isolation (symptom awareness)
  I(state~M)->I(state~Q) jQfunc()
  I(state~P)->I(state~Q) jQ

  # Incubation (progression through the 5 Erlang stages)
  E1(state~M)->E2(state~M) kL
  E1(state~P)->E2(state~P) kL
  E2(state~M)->E3(state~M) kL
  E2(state~P)->E3(state~P) kL
  E2(state~Q)->E3(state~Q) kL
  E3(state~M)->E4(state~M) kL
  E3(state~P)->E4(state~P) kL
  E3(state~Q)->E4(state~Q) kL
  E4(state~M)->E5(state~M) kL
  E4(state~P)->E5(state~P) kL
  E4(state~Q)->E5(state~Q) kL
  E5(state~M)->A(state~M) kL*fA
  E5(state~P)->A(state~P) kL*fA
  E5(state~Q)->A(state~Q) kL*fA
  E5(state~M)->I(state~M) kL*(1-fA)
  E5(state~P)->I(state~P) kL*(1-fA)
  E5(state~Q)->I(state~Q) kL*(1-fA)

  # Immune clearance / recovery from mild disease
  A(state~M)->R() cA
  A(state~P)->R() cA
  A(state~Q)->R() cA
  I(state~M)->R() cIfunc()*(1-fH)
  I(state~P)->R() cI*(1-fH)
  I(state~Q)->R() cI*(1-fH)

  # Progression to severe disease / hospitalization
  I(state~M)->H() cIfunc()*fH
  I(state~P)->H() cI*fH
  I(state~Q)->H() cI*fH

  # Severe disease outcomes
  H()->R() cH*fR
  H()->D() cH*(1-fR)

end reaction rules

end model

begin actions

  generate_network({overwrite=>1})  # 27 species, 62 reactions

  #@note: |
  #  ODE-only, for the same reasons as the primary: the counter() clock and the
  #  if(t>...) rate-law functions require deterministic integration, and the
  #  ~19.2M population is far too large for SSA. NFsim does not support if() rate
  #  laws.

  # NYC daily new-case forecast, first wave (single-phase)

  #@protocol: |
  #  Integrate the compartmental ODE over the first COVID-19 wave (model day
  #  t = 0..151) at the independent de best fit. The fit observable
  #  CumNum_detected_cases_Cum() is a detected-case count; its day-to-day
  #  increment (differenced in the notebook) is the daily new-case forecast,
  #  overlaid on the New York Times data (fit window t = 50..151). With a single
  #  social-distancing phase the model overshoots the peak (~22,500 vs ~15,900
  #  cases/day) -- motivating the two-phase primary.

  #@figure: Fig. 3 in Lin et al. (2021)

  simulate({method=>"ode",suffix=>"ode",t_start=>0,t_end=>151,n_steps=>151,\
    print_functions=>1})

end actions
