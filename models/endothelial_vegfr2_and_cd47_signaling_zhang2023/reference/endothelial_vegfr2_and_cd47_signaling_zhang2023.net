   10 J_IP3R_ER() ((((-Iip3Ramp)*(Caer-Cac))*((freeip3cyto^3.8)/((freeip3cyto^3.8)+(KmIP3R^3.8))))*((KiCa^3.8)/((KiCa^3.8)+(Cac^3.8))))*(1/(1+(CSQN_total/((KCSQN+Caer)^2))))
   11 J_PMCA_CRAC() (((-I_PMCAbar)*(Cac^1.4))/((KmPMCA^1.4)+(Cac^1.4)))+Iopenstim
   12 J_SERCA_leak_cyto() ((-vSERCA)*((Cac/(KmSERCA+Cac))^2))+(KleakER*((Caer-Cac)^2))
