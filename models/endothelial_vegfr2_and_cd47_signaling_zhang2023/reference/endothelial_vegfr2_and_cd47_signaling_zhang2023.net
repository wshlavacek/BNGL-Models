    7 k_PLCgamma_PIP2() (kcatPLCgammaDAG*(freepip2^(nDAG-1)))/((kmPIP2PLCgamma^nDAG)+(freepip2^nDAG))
    8 d_Istim() ((ICracamp*((Kcrac^ncrac)/((Kcrac^ncrac)+(Caer^ncrac))))/tau_stim)-(Iopenstim/tau_stim)
