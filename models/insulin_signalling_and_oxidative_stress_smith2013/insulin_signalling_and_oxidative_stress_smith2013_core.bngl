begin model

#@title: |
#  Insulin signalling and oxidative stress, core pathway
#  (Smith and Shanley, 2013)

#@description: |
#  The core insulin-signalling and ROS module of Smith and Shanley (2013),
#  without the stress-activated kinases and without FOXO1 and its
#  transcriptional feedback. Insulin binding to InR drives IRS1 tyrosine
#  phosphorylation, PI3K recruitment, PI(3,4,5)P3 production, Akt and PKC-zeta
#  activation, and AS160-gated GLUT4 translocation; insulin-activated NOX makes
#  ROS that reversibly oxidizes PTP1B and PTEN. This is the configuration in
#  which the published short-term insulin panels were computed: in the authors'
#  model the SAPK and FOXO1 modules are switched off by the indicator
#  parameters for those figures, and switching them off is exactly equivalent
#  to deleting them, because every reaction they gate is inactive. A 100 nM
#  insulin pulse lasting fifteen minutes gives an Akt phosphorylation peak of
#  0.099 of total at 3.8 minutes, a PKC peak of 0.130 at 3.5 minutes, an IRS1
#  tyrosine-phosphorylation peak of 0.390 at 1 minute, and a GLUT4 surface
#  fraction rising from 0.04 to 0.460 at 18.5 minutes before decaying to 0.15
#  by one hour.

#@keyword: |
#  insulin signalling, oxidative stress, signal transduction, GLUT4
#  translocation, negative feedback, mass action, phosphatase oxidation,
#  adipocyte, Rattus norvegicus

#@reference: |
#  Smith GR, Shanley DP (2013). Computational modelling of the regulation of
#  Insulin signalling by oxidative stress. BMC Systems Biology 7:41.
#  doi:10.1186/1752-0509-7-41

#@note: |
#  Variant of insulin_signalling_and_oxidative_stress_smith2013 holding the
#  core insulin-signalling and ROS modules only. Relative to the primary model
#  this file omits JNK, IKK and DUSP, the Michaelis-Menten serine
#  phosphorylation of IRS1 by the SAPKs, FOXO1 and its post-translational
#  modification and transport network, and InR and SOD2 transcription; SOD2 is
#  therefore constant. This reproduces the authors' indicator_jnk = 0,
#  indicator_foxo = 0 configuration exactly. See the primary file for the
#  compartment, FOXO1 and ros_perm conversion notes, which apply here as well.

begin parameters
  # Population-conversion constants. The model is written in molecule counts,
  # so these are used only by the commented dimensional-conversion functions.
  NA        6.02214076e23  # molecules/mol
  V_ref     1.65e-11       # L/cell
  h_mem     2e-8           # m

  # Compartment volumes; see Table 2 in Smith and Shanley (2013). Reactions are
  # written directly in molecule counts, so no volume scaling is applied to any
  # rate law and no compartments block is used (see the header note).
  v_extracellular  8.3e-12   # L/cell
  v_cellsurface    6.4e-14   # L/cell
  v_cytoplasm      1.65e-11  # L/cell
  v_nucleus        5e-13     # L/cell
  v_dnabound       1e-13     # L/cell
  membrane_area    6.5e-9    # cm^2/cell

  # Display scale factors. One ROS or phosphoinositide particle in the model
  # stands for 1000 real molecules; see the ROS interactions section.
  sc_ros    1000  # molecules/particle
  sc_pip    1000  # molecules/particle

  # Insulin-InR association and dissociation, fitted to bound insulin in rat
  # adipocytes; see Fig. 1 in Stagsted et al. (1993) and Table 2 in Smith and
  # Shanley (2013)
  k1        2.0e-5  # /molecule/min
  kminus1   12072   # /min

  # Insulin binding to the phosphorylated receptor
  k2        1.2e-5  # /molecule/min
  kminus2   9.0e4   # /min

  # InR autophosphorylation and PTP1B-mediated dephosphorylation at the surface
  k3        2500    # /min
  kminus3   2.0e-6  # /molecule/min

  # Internalization and recycling of unliganded and of phosphorylated receptor.
  # Table 2 in Smith and Shanley (2013) lists k4 = 0.0333 and kminus4 = 0.3;
  # the values below are one hundred times smaller, preserving the tabulated
  # ratio of ten and therefore the resting receptor distribution, and are the
  # ones that reproduce the published figures (see the header note).
  k4          3.33333e-4 # /min
  kminus4     3e-3       # /min
  k4prime     0.0021     # /min
  kminus4prime 2.1e-4    # /min

  # PTP1B-mediated dephosphorylation of internalized receptor
  k6        4.61e-6  # /molecule/min

  # IRS1 tyrosine phosphorylation by active InR; the receptor term is
  # normalized by IRp, the surface receptor number of the reference state
  k7        5.8      # /min
  IRp       9.0e4    # molecules
  kminus7a  8.75e-5  # /molecule/min

  # IRS1 composite serine phosphorylation by active PKC and its reversal
  k2psp     2.2e-4  # /molecule/min
  kminus7b  2.8e-6  # /molecule/min

  # IRS1-PI3K complex formation; see Fig. 3 in Stagsted et al. (1993)
  k8        2.6e-6  # /molecule/min
  kminus8   1.55    # /min

  # IRS1 synthesis and turnover; serine phosphorylation accelerates degradation
  # about tenfold. Table 2 in Smith and Shanley (2013) lists 260 for the
  # synthesis rate; 130 is the value that reproduces the published figures.
  k_irs1_basal_syn      130    # molecules/min
  k_irs1_basal_degr     1e-3   # /min
  k_irs1_polyserp_degr  1e-2   # /min

  # PIP2 to PI(3,4,5)P3 conversion, basal and by the IRS1-PI3K complex
  k9_basal       0.13145  # /min
  k9             0.0055   # /molecule/min

  # PI(3,4,5)P3 breakdown, basal and by reduced PTEN
  kminus9_basal  2.7      # /min
  kminus9        0.0014   # /molecule/min

  # Akt activation above the basal PI(3,4,5)P3 offset, and PP2A reversal
  k11        2.5e-5     # /molecule/min
  pip3_basal 200        # molecules
  kminus11   1.1878e-6  # /molecule/min

  # PKC-zeta activation with the same PI(3,4,5)P3 offset, and PP2A reversal
  k12        3.5e-5   # /molecule/min
  kminus12   1.25e-6  # /molecule/min

  # AS160 activation by active Akt and PP2A reversal
  kr16a       3.33e-4  # /molecule/min
  kminusr16a  1e-6     # /molecule/min

  # GLUT4 translocation to the cell surface, basal and by active AS160, and
  # the reverse internalization
  k13_basal  0.015    # /min
  k13        7.5e-6   # /molecule/min
  kminus13   0.167    # /min

  # Reversible oxidation of the catalytic cysteine of PTP1B, and reduction by
  # glutathione
  k30f      0.08     # /molecule/min
  k30r      5e-3     # /molecule/min

  # The same cycle for PTEN, which is oxidized far more slowly
  k31f      2.7e-4   # /molecule/min
  k31r      2e-3     # /molecule/min

  # Insulin-driven NOX activation, spontaneous deactivation and slow recovery.
  # k34r1 and k34r3 are second order in the NOX species itself.
  k34f      2e-5   # /molecule/min
  k34r1     1e-3   # /molecule/min
  k34r2     0.25   # /min
  k34r3     1e-3   # /molecule/min

  # ROS production by active NOX and by mitochondria, and removal by SOD2
  k35f      450    # /min
  k35r      0.12   # /molecule/min
  k36f      180    # /min

  # ROS permeation across the plasma membrane; see Adimora et al. (2010).
  # Table 2 in Smith and Shanley (2013) lists ros_perm as 7.8e8, but 7.4e8 is
  # the value that gives the reported k_ros_perm of about 4.8 per minute and is
  # the value in the authors' SBML model.
  ros_perm      7.4e8  # thousands/cm^2/min
  k_ros_perm    ros_perm*membrane_area                 # /min
  k_ros_efflux  k_ros_perm*v_extracellular/v_cytoplasm # /min

  # Glutathione oxidation by ROS and spontaneous reduction
  k38f      0.05  # /molecule/min
  k38r      2.0   # /min

  # Protocol doses, given as extracellular concentrations and converted to the
  # clamped particle numbers of the seed species.
  # Insulin is 100 nM for the dosing interval and there is no
  # external H2O2.
  Ins_conc      1e-7  # M
  ROS_ext_conc  0  # M
  Ins_dose      Ins_conc*NA*v_extracellular          # molecules
  ROS_ext_dose  ROS_ext_conc*NA*v_extracellular/sc_ros  # molecules

  # Initial particle numbers; see Table 1 in Smith and Shanley (2013)
  InR_pm_0      9.0e4    # molecules
  InR_cyt_0     1.0e4    # molecules
  PTP1B_0       1.0e5    # molecules
  IRS1_0        1.0e5    # molecules
  PI3K_0        1.0e4    # molecules
  PP2A_0        5.0e5    # molecules
  PTEN_0        1.0e5    # molecules
  GSH_0         100      # molecules
  NOX_0         100      # molecules
  SOD2_0        4.17e4   # molecules
  Mt_0          50       # molecules
  Akt_0         1.0e5    # molecules
  AS160_0       2.0e4    # molecules
  PKC_0         1.0e5    # molecules
  PIP2_0        2.0e5    # molecules
  PIP3_0        1.0e3    # molecules
  GLUT4_cyt_0   9.6e4    # molecules
  GLUT4_pm_0    4.0e3    # molecules
end parameters

begin molecule types
  # Insulin, held at a fixed extracellular level during a dosing interval
  Ins()

  # Insulin receptor. ins counts bound insulin, y is the autophosphorylation
  # state, and loc distinguishes the cell surface from the internalized pool.
  InR(ins~0~1~2,y~u~p,loc~pm~cyt)

  # Protein tyrosine phosphatase 1B; ox is the reversibly oxidized catalytic
  # cysteine
  PTP1B(ox~0~1)

  # Lipid phosphatase PTEN, oxidized on the same catalytic cysteine
  PTEN(ox~0~1)

  # Protein phosphatase 2A, the serine/threonine phosphatase of the pathway
  PP2A()

  # Insulin receptor substrate 1. y is the tyrosine site, s is the composite
  # poly-serine modification, and pi3k is the PI3K docking site.
  IRS1(y~u~p,s~u~p,pi3k)

  # Phosphoinositide 3-kinase
  PI3K(irs)

  # Plasma-membrane phosphoinositide; p~2 is PI(4,5)P2 and p~3 is PI(3,4,5)P3
  PIP(p~2~3)

  # Akt/PKB
  Akt(s~u~p)

  # PKC-zeta, the isoform activated by insulin signalling
  PKC(s~u~p)

  # Akt substrate of 160 kDa, which gates GLUT4 translocation
  AS160(s~u~p)

  # GLUT4 glucose transporter; cell-surface GLUT4 proxies glucose uptake
  GLUT4(loc~cyt~pm)

  # Generic reactive oxygen species; one particle stands for 1000 molecules
  ROS(loc~ext~cyt)

  # NADPH oxidase, cycling between inactive, active and deactivated states
  NOX(s~i~a~d)

  # Superoxide dismutase 2, the lumped antioxidant enzyme
  SOD2()

  # Glutathione; ox~1 is the oxidized GSSG form
  GSH(ox~0~1)

  # Mitochondria, the source of basal ROS production
  Mt()
end molecule types

begin seed species
  # Insulin is clamped at the protocol dose; the actions block sets it to zero
  # at the end of the dosing interval
  $Ins()  Ins_dose  # molecules

  # External ROS is clamped at the protocol dose
  $ROS(loc~ext)  ROS_ext_dose  # molecules

  # Unliganded receptor is split between the cell surface and the cytoplasm
  InR(ins~0,y~u,loc~pm)   InR_pm_0   # molecules
  InR(ins~0,y~u,loc~cyt)  InR_cyt_0  # molecules

  PTP1B(ox~0)  PTP1B_0  # molecules
  PTEN(ox~0)   PTEN_0   # molecules
  PP2A()       PP2A_0   # molecules

  IRS1(y~u,s~u,pi3k)  IRS1_0  # molecules
  PI3K(irs)           PI3K_0  # molecules

  PIP(p~2)  PIP2_0  # molecules
  PIP(p~3)  PIP3_0  # molecules

  Akt(s~u)    Akt_0    # molecules
  PKC(s~u)    PKC_0    # molecules
  AS160(s~u)  AS160_0  # molecules

  GLUT4(loc~cyt)  GLUT4_cyt_0  # molecules
  GLUT4(loc~pm)   GLUT4_pm_0   # molecules

  ROS(loc~cyt)  0       # molecules
  NOX(s~i)      NOX_0   # molecules
  GSH(ox~0)     GSH_0   # molecules
  Mt()          Mt_0    # molecules

  # SOD2 is constant in this variant because the transcription module is absent
  SOD2()  SOD2_0  # molecules
end seed species

begin observables
  # Extracellular insulin, clamped at the protocol dose; this traces the pulse
  Molecules Obs_Tot_Ins Ins()

  # Receptor pools: total, surface-bound and catalytically active
  Molecules Obs_Tot_InR         InR()
  Molecules Obs_State_InR_bound InR(ins~1,loc~pm) InR(ins~2,loc~pm)
  Molecules Obs_State_InR_active InR(y~p,loc~pm)

  # IRS1 pools. Obs_State_IRS1_TyrP is the free tyrosine-phosphorylated form
  # plotted as IRS-Yp, and Obs_State_IRS1_unmod enters the Michaelis-Menten
  # denominators of the SAPK serine-phosphorylation rate laws.
  Molecules Obs_Tot_IRS1         IRS1()
  Molecules Obs_State_IRS1_TyrP  IRS1(y~p,s~u,pi3k)
  Molecules Obs_State_IRS1_unmod IRS1(y~u,s~u,pi3k)
  Molecules Obs_Cplx_IRS1_PI3K   IRS1(pi3k!1).PI3K(irs!1)

  # Phosphoinositide and kinase activation states
  Molecules Obs_State_PIP3     PIP(p~3)
  Molecules Obs_Tot_Akt        Akt()
  Molecules Obs_State_Akt_P    Akt(s~p)
  Molecules Obs_Tot_PKC        PKC()
  Molecules Obs_State_PKC_P    PKC(s~p)
  Molecules Obs_State_AS160_P  AS160(s~p)

  # GLUT4 at the cell surface proxies glucose uptake
  Molecules Obs_Tot_GLUT4       GLUT4()
  Molecules Obs_State_GLUT4_pm  GLUT4(loc~pm)

  # Reduced (catalytically competent) phosphatase pools
  Molecules Obs_Tot_PTP1B       PTP1B()
  Molecules Obs_State_PTP1B_red PTP1B(ox~0)
  Molecules Obs_Tot_PTEN        PTEN()
  Molecules Obs_State_PTEN_red  PTEN(ox~0)

  # ROS, its sources and the antioxidant pools
  Molecules Obs_State_ROS_cyt    ROS(loc~cyt)
  Molecules Obs_State_ROS_ext    ROS(loc~ext)
  Molecules Obs_State_NOX_active NOX(s~a)
  Molecules Obs_State_NOX_deact  NOX(s~d)
  Molecules Obs_Tot_SOD2         SOD2()
  Molecules Obs_State_GSH_red    GSH(ox~0)
end observables

begin functions
  # IRS1 tyrosine phosphorylation is driven by the active surface receptor pool
  # normalized by IRp; see R12f in Table 2 of Smith and Shanley (2013)
  fcn_irs_tyr_phos() = k7*Obs_State_InR_active/IRp

  # PI(3,4,5)P3 synthesis, basal plus IRS1-PI3K driven, and its breakdown,
  # basal plus by reduced PTEN
  fcn_pip3_syn() = k9_basal + k9*Obs_Cplx_IRS1_PI3K
  fcn_pip3_deg() = kminus9_basal + kminus9*Obs_State_PTEN_red

  # Akt and PKC activation respond only to PI(3,4,5)P3 above the basal offset,
  # so that both are inactive at the resting phosphoinositide level
  fcn_akt_phos() = k11*if(Obs_State_PIP3>pip3_basal,Obs_State_PIP3-pip3_basal,0)
  fcn_pkc_phos() = k12*if(Obs_State_PIP3>pip3_basal,Obs_State_PIP3-pip3_basal,0)

  # GLUT4 translocation to the cell surface, basal plus AS160 driven
  fcn_glut4_out() = k13_basal + k13*Obs_State_AS160_P

  # NOX deactivation and recovery are second order in the NOX species itself,
  # so the reactant factor supplied by BioNetGen is multiplied by one more
  # copy of the same observable
  fcn_nox_deact() = k34r1*Obs_State_NOX_active
  fcn_nox_recover() = k34r3*Obs_State_NOX_deact

  # Fractional activations plotted in Fig. 2 of Smith and Shanley (2013)
  Frac_Akt_P() = Obs_State_Akt_P/Obs_Tot_Akt
  Frac_PKC_P() = Obs_State_PKC_P/Obs_Tot_PKC
  Frac_IRS1_TyrP() = Obs_State_IRS1_TyrP/Obs_Tot_IRS1
  Frac_GLUT4_pm() = Obs_State_GLUT4_pm/Obs_Tot_GLUT4
  Frac_PTP1B_active() = Obs_State_PTP1B_red/Obs_Tot_PTP1B

  # Dimensional conversions (uncomment for concentration output). The names end
  # in _M because Ins_conc and ROS_ext_conc are already the dose parameters.
# Ins_conc_M() = Obs_Tot_Ins/(NA*v_extracellular)  # M
# ROS_cyt_conc_M() = sc_ros*Obs_State_ROS_cyt/(NA*v_cytoplasm)  # M
# ROS_ext_conc_M() = sc_ros*Obs_State_ROS_ext/(NA*v_extracellular)  # M
# PIP3_conc_M() = sc_pip*Obs_State_PIP3/(NA*v_cytoplasm)  # M
end functions

begin reaction rules
  # Insulin binds the unliganded surface receptor, which then autophosphorylates
  # and can bind a second insulin
  R_bind_Ins_InR: Ins() + InR(ins~0,y~u,loc~pm) -> InR(ins~1,y~u,loc~pm) k1
  R_unbind_Ins_InR: InR(ins~1,y~u,loc~pm) -> Ins() + InR(ins~0,y~u,loc~pm) kminus1
  R_phos_InR: InR(ins~1,y~u,loc~pm) -> InR(ins~1,y~p,loc~pm) k3
  R_bind_Ins_InR_P: Ins() + InR(ins~1,y~p,loc~pm) -> InR(ins~2,y~p,loc~pm) k2
  R_unbind_Ins_InR_P: InR(ins~2,y~p,loc~pm) -> Ins() + InR(ins~1,y~p,loc~pm) kminus2

  # Reduced PTP1B dephosphorylates the singly liganded surface receptor,
  # releasing its insulin
  R_dephos_InR_pm: PTP1B(ox~0) + InR(ins~1,y~p,loc~pm) -> \
    PTP1B(ox~0) + InR(ins~0,y~u,loc~pm) kminus3

  # Unliganded receptor cycles between the surface and the cytoplasm; the
  # phosphorylated forms internalize far more slowly
  R_internalize_InR: InR(ins~0,y~u,loc~pm) <-> InR(ins~0,y~u,loc~cyt) k4, kminus4
  R_internalize_InR_P: InR(y~p,loc~pm) <-> InR(y~p,loc~cyt) k4prime, kminus4prime

  # Reduced PTP1B also resets the internalized phosphorylated receptor
  R_dephos_InR_cyt: PTP1B(ox~0) + InR(y~p,loc~cyt) -> \
    PTP1B(ox~0) + InR(ins~0,y~u,loc~cyt) k6

  # Active surface receptor phosphorylates IRS1 on tyrosine; reduced PTP1B
  # reverses it
  R_phos_IRS_Tyr: IRS1(y~u,s~u,pi3k) -> IRS1(y~p,s~u,pi3k) fcn_irs_tyr_phos()
  R_dephos_IRS_Tyr: PTP1B(ox~0) + IRS1(y~p,s~u,pi3k) -> \
    PTP1B(ox~0) + IRS1(y~u,s~u,pi3k) kminus7a

  # Active PKC writes the composite serine modification on either tyrosine
  # state; PP2A removes it
  R_phos_IRS_Ser_PKC: PKC(s~p) + IRS1(s~u,pi3k) -> PKC(s~p) + IRS1(s~p,pi3k) k2psp
  R_dephos_IRS_Ser: PP2A() + IRS1(s~p,pi3k) -> PP2A() + IRS1(s~u,pi3k) kminus7b

  # Only tyrosine-phosphorylated, serine-unmodified IRS1 recruits PI3K
  R_bind_IRS_PI3K: PI3K(irs) + IRS1(y~p,s~u,pi3k) <-> \
    PI3K(irs!1).IRS1(y~p,s~u,pi3k!1) k8, kminus8

  # IRS1 synthesis and turnover; the serine-modified forms are degraded about
  # ten times faster
  R_syn_IRS: 0 -> IRS1(y~u,s~u,pi3k) k_irs1_basal_syn
  R_degrade_IRS: IRS1(s~u,pi3k) -> 0 k_irs1_basal_degr
  R_degrade_IRS_SerP: IRS1(s~p,pi3k) -> 0 k_irs1_polyserp_degr

  # PI(4,5)P2 to PI(3,4,5)P3 interconversion by the IRS1-PI3K complex and PTEN
  R_syn_PIP3: PIP(p~2) -> PIP(p~3) fcn_pip3_syn()
  R_degrade_PIP3: PIP(p~3) -> PIP(p~2) fcn_pip3_deg()

  # Akt and PKC activation by PI(3,4,5)P3 above the basal offset, reversed by
  # PP2A
  R_phos_Akt: Akt(s~u) -> Akt(s~p) fcn_akt_phos()
  R_dephos_Akt: PP2A() + Akt(s~p) -> PP2A() + Akt(s~u) kminus11
  R_phos_PKC: PKC(s~u) -> PKC(s~p) fcn_pkc_phos()
  R_dephos_PKC: PP2A() + PKC(s~p) -> PP2A() + PKC(s~u) kminus12

  # AS160 relays Akt activation to GLUT4 and saturates well below full Akt
  # activation
  R_phos_AS160: Akt(s~p) + AS160(s~u) -> Akt(s~p) + AS160(s~p) kr16a
  R_dephos_AS160: PP2A() + AS160(s~p) -> PP2A() + AS160(s~u) kminusr16a

  # GLUT4 translocation to and from the cell surface
  R_translocate_GLUT4_out: GLUT4(loc~cyt) -> GLUT4(loc~pm) fcn_glut4_out()
  R_translocate_GLUT4_in: GLUT4(loc~pm) -> GLUT4(loc~cyt) kminus13

  # Insulin activates NOX directly; active NOX then deactivates and only slowly
  # returns to the inactive state
  R_activate_NOX: Ins() + NOX(s~i) -> Ins() + NOX(s~a) k34f
  R_deactivate_NOX: NOX(s~a) -> NOX(s~d) fcn_nox_deact()
  R_inactivate_NOX: NOX(s~a) -> NOX(s~i) k34r2
  R_recover_NOX: NOX(s~d) -> NOX(s~i) fcn_nox_recover()

  # ROS production by active NOX and by mitochondria, and its removal by SOD2
  R_produce_ROS_NOX: NOX(s~a) -> NOX(s~a) + ROS(loc~cyt) k35f
  R_produce_ROS_Mt: Mt() -> Mt() + ROS(loc~cyt) k36f
  R_remove_ROS_SOD2: SOD2() + ROS(loc~cyt) -> SOD2() k35r

  # ROS permeates the plasma membrane in both directions
  R_import_ROS: ROS(loc~ext) -> ROS(loc~cyt) k_ros_perm
  R_export_ROS: ROS(loc~cyt) -> ROS(loc~ext) k_ros_efflux

  # ROS reversibly oxidizes the catalytic cysteines of PTP1B and PTEN,
  # inactivating them; glutathione restores them
  R_oxidize_PTP1B: ROS(loc~cyt) + PTP1B(ox~0) -> ROS(loc~cyt) + PTP1B(ox~1) k30f
  R_reduce_PTP1B: GSH(ox~0) + PTP1B(ox~1) -> GSH(ox~0) + PTP1B(ox~0) k30r
  R_oxidize_PTEN: ROS(loc~cyt) + PTEN(ox~0) -> ROS(loc~cyt) + PTEN(ox~1) k31f
  R_reduce_PTEN: GSH(ox~0) + PTEN(ox~1) -> GSH(ox~0) + PTEN(ox~0) k31r

  # Glutathione is itself oxidized by ROS at high oxidative stress
  R_oxidize_GSH: ROS(loc~cyt) + GSH(ox~0) -> ROS(loc~cyt) + GSH(ox~1) k38f
  R_reduce_GSH: GSH(ox~1) -> GSH(ox~0) k38r
end reaction rules

end model

begin actions
  generate_network({overwrite=>1})  # 38 species, 52 reactions
  saveConcentrations()

  # Short-term response to a fifteen-minute insulin pulse

  #@protocol: |
  #  Phase 1: expose the cell to 100 nM insulin, about 500000 molecules in the
  #  extracellular volume, for fifteen minutes, the dosing bar of the panels.
  #  Phase 2: wash the insulin out and follow the decay to one hour.
  #  Frac_Akt_P and Frac_GLUT4_pm reproduce Fig. 2A, Frac_IRS1_TyrP and
  #  Frac_PKC_P reproduce Fig. 2C, and Frac_PTP1B_active with
  #  Obs_State_ROS_cyt reproduce Fig. 2D over the first fifteen minutes. Akt
  #  peaks near 0.10 of total at about four minutes while GLUT4 continues to
  #  accumulate at the surface until about twenty minutes, and IRS1 tyrosine
  #  phosphorylation is cut back by PKC-driven serine phosphorylation.

  #@figure: Fig. 2A, Fig. 2C and Fig. 2D in Smith and Shanley (2013)

  resetConcentrations()
  simulate({method=>"ode",suffix=>"ode",t_start=>0,t_end=>15,n_steps=>150,\
    print_functions=>1,atol=>1e-10,rtol=>1e-10})
  setConcentration("Ins()",0)
  simulate({method=>"ode",suffix=>"ode",t_start=>15,t_end=>60,n_steps=>450,\
    continue=>1,print_functions=>1,atol=>1e-10,rtol=>1e-10})

  #@note: |
  #  Exact SSA and partitioned leaping are omitted: the model holds more than a
  #  million molecules and contains a zeroth-order IRS1 synthesis reaction.
  #  NFsim is not applicable because the rate laws reference global observables.
end actions
