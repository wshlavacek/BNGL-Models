%init: 1 g_mbtB(site{a}[.])
%init: 1 g_mbtE()
%init: 1 g_mbtF()
%init: 5000 Fe(site{st_3ex}[.] site1[.])
%init: 50 Fe(site{mtb}[.] site1[.])
%init: 20000 RBC(site{a}[.])

%obs: 'Obs_Fe_mtb' |Fe(site{mtb}[.])|
%obs: 'Obs_Fe_3ex' |Fe(site{st_3ex}[.])|
%obs: 'Obs_Fer_Fe' |Fe(site{fer}[_])|
%obs: 'Obs_Fe_myB' |m(site1[_])|
%obs: 'Obs_Fe_cmB' |cmex(site1[_])|
%obs: 'Obs_act_ideR' |ideR(Fe1[_] Fe2[_] Fe3[_] ideR[_])|
%obs: 'Obs_Tf_TfR' |Tf(tfR{a}[_])|
%obs: 'Obs_RBC' |RBC(site{a}[.])|

'R1' g_tf() -> g_tf(), Tf(Fe1[.] Fe2{n}[.] tfR{u}[.]) @ 'k1'  // Tf synthesis
'R2' Tf(Fe1[.] Fe2{n}[.] tfR{u}[.]) -> . @ 'k2'  // Tf decay st
'R3' Fe(site{st_3ex}[.]), Tf(Fe1[.] Fe2{n}[.] tfR{u}[.]) -> Fe(site{st_3ex}[1]), Tf(Fe1[1] Fe2{n}[.] tfR{u}[.]) @ 'k3'  // 1 Fe binds to Tf
'R4' Tf(Fe1[_] Fe2{n}[.] tfR{u}[.]) -> Tf(Fe1[_] Fe2{n}[.] tfR{a}[.]) @ 'k4'  // Modification in TfR binding site on iron binding
'R5' Tf(Fe2{n}[.] tfR{a}[.]) -> Tf(Fe2{a}[.] tfR{a}[.]) @ 'k5'  // Modification in nd 2 Fe binding site on iron binding nd
'R6' Fe(site{st_3ex}[.]), Tf(Fe2{a}[.]) -> Fe(site{st_3ex}[1]), Tf(Fe2{a}[1]) @ 'k6'  // 2 Fe binding
'R7' g_tfR() -> g_tfR(), TfR(Tf[.]) @ 'k7'  // TfR synthesis
'R8' TfR(Tf[.]) -> . @ 'k8'  // TfR decay
'R9' Tf(Fe1[_] Fe2{a}[#] tfR{a}[.]), TfR(Tf[.]) -> Tf(Fe1[_] Fe2{a}[#] tfR{a}[1]), TfR(Tf[1]) @ 'k9'  // Holo Tf binds to TfR
'R10' Tf(Fe1[_] tfR{a}[_]) -> Tf(Fe1[_] tfR{a}[.]) @ 'k10'  // Dissociation of Tf-Fe-TfR complex
'R11' Tf(Fe1[_] tfR{a}[_]) -> Tf(Fe1[_] tfR{inside}[_]) @ 'k11'  // Transport of the Tf-Fe-TfR complex to the endosome (Tf- TfR endocytic cycle) st
'R12' Fe(site{st_3ex}[2]), Tf(Fe1[_] Fe2{a}[2] tfR{inside}[_]) -> Fe(site{st_3ed}[.]), Tf(Fe1[_] Fe2{a}[.] tfR{inside}[_]) @ 'k12'  // Release of 1 Fe nd
'R13' Fe(site{st_3ex}[2]), Tf(Fe1[2] Fe2{a}[.] tfR{inside}[_]) -> Fe(site{st_3ed}[.]), Tf(Fe1[.] Fe2{a}[.] tfR{inside}[_]) @ 'k13'  // Release of 2 Fe
'R14' Tf(Fe2{a}[.] tfR{inside}[_]) -> Tf(Fe2{a}[.] tfR{out}[_]) @ 'k14'  // Transport of Fe less Tf-TfR outside
'R15' Tf(Fe2{a}[.] tfR{out}[1]), TfR(Tf[1]) -> Tf(Fe2{n}[.] tfR{u}[.]), TfR(Tf[.]) @ 'k15'  // Dissociation of Tf-TfR
'R16' g_dcytb() -> g_dcytb(), Dcytb(site[.]) @ 'k16'  // Dcytb synthesis
'R17' Dcytb(site[.]) -> . @ 'k17'  // Dcytb decay +3
'R18' Dcytb(site[.]), Fe(site{st_3ed}[.]) -> Dcytb(site[1]), Fe(site{st_3ed}[1]) @ 'k18'  // Fe reduction by Dcytb (I) +3
'R19' Dcytb(site[1]), Fe(site{st_3ed}[1]) -> Dcytb(site[.]), Fe(site{st_2ed}[.]) @ 'k19'  // Fe reduction by Dcytb (II)
'R20' g_dmt() -> g_dmt(), DMT(site[.]) @ 'k20'  // DMT synthesis
'R21' DMT(site[.]) -> . @ 'k21'  // DMT decay
'R22' DMT(site[.]), Fe(site{st_2ed}[.]) -> DMT(site[1]), Fe(site{st_2ed}[1]) @ 'k22'  // DMT-Fe complex (I)
'R23' DMT(site[1]), Fe(site{st_2ed}[1]) -> DMT(site[.]), Fe(site{st_2cy}[.]) @ 'k23'  // DMT-Fe complex (II)
'R24' g_fer() -> g_fer(), Fer(Fe[.]) @ 'k24'  // Ferritin synthesis
'R25' Fer(Fe[.]) -> . @ 'k25'  // Ferritin decay
'R26' Fe(site{st_2cy}[.]), Fer(Fe[.]) -> Fe(site{fer}[1]), Fer(Fe[1]) @ 'k26'  // Iron storage in ferritin
'R27' g_fp() -> g_fp(), fp(site[.]) @ 'k27'  // Fp synthesis
'R28' fp(site[.]) -> . @ 'k28'  // Fp decay
'R29' Fe(site{fer}[1]), fp(site[.]), Fer(Fe[1]) -> Fe(site{fp}[1]), fp(site[1]) @ 'k29'  // Fp extracts iron stored in ferritin and degrades ferritin in the process (I)
'R30' Fe(site{fp}[1]), fp(site[1]) -> Fe(site{st_2ex}[.]), fp(site[.]) @ 'k30'  // Fp extracts iron stored in ferritin and degrades ferritin in the process (II)
'R31' Fe(site{st_2cy}[.]), fp(site[.]) -> Fe(site{fp}[1]), fp(site[1]) @ 'k31'  // Fp exports cytoplasmic iron outside
'R32' g_cp() -> g_cp(), Cp(site[.]) @ 'k32'  // Cp synthesis
'R33' Cp(site[.]) -> . @ 'k33'  // Cp decay
'R34' Cp(site[.]), Fe(site{st_2ex}[.]) -> Cp(site[1]), Fe(site{st_2ex}[1]) @ 'k34'  // Cp dependent +2 oxidation of Fe (I)
'R35' Cp(site[1]), Fe(site{st_2ex}[1]) -> Cp(site[.]), Fe(site{st_3ex}[.]) @ 'k35'  // Cp dependent +2 oxidation of Fe (II)
'R36' g_mf() -> g_mf(), mf(site[.]) @ 'k36'  // mf synthesis
'R37' mf(site[.]) -> . @ 'k37'  // mf decay
'R38' mf(site[.]), Fe(site{st_2cy}[.]) -> mf(site[1]), Fe(site{st_2cy}[1]) @ 'k38'  // Iron transport to mitochondria via mf (I)
'R39' mf(site[1]), Fe(site{st_2cy}[1]) -> mf(site[.]), Fe(site{st_2mt}[.]) @ 'k39'  // Iron transport to mitochondria via mf (II)
'R40' g_fra() -> g_fra(), fra(isu[.] site1[.] site2[.] site3[.] site4[.] site5[.] site6[.]) @ 'k40'  // frataxin synthesis
'R41' fra(isu[.] site1[.] site2[.] site3[.] site4[.] site5[.] site6[.]) -> . @ 'k41'  // frataxin decay
'R42' Fe(site{st_2mt}[.]), fra(site1[.]) -> Fe(site{st_2mt}[1]), fra(site1[1]) @ 'k42'  // fra binds to iron in the mitochondria (I)
'R43' Fe(site{st_2mt}[.]), fra(site2[.]) -> Fe(site{st_2mt}[1]), fra(site2[1]) @ 'k43'  // fra binds to iron in the mitochondria (II)
'R44' Fe(site{st_2mt}[.]), fra(site3[.]) -> Fe(site{st_2mt}[1]), fra(site3[1]) @ 'k44'  // fra binds to iron in the mitochondria (III)
'R45' Fe(site{st_2mt}[.]), fra(site4[.]) -> Fe(site{st_2mt}[1]), fra(site4[1]) @ 'k45'  // fra binds to iron in the mitochondria (IV)
'R46' Fe(site{st_2mt}[.]), fra(site5[.]) -> Fe(site{st_2mt}[1]), fra(site5[1]) @ 'k46'  // fra binds to iron in the mitochondria (V)
'R47' Fe(site{st_2mt}[.]), fra(site6[.]) -> Fe(site{st_2mt}[1]), fra(site6[1]) @ 'k47'  // fra binds to iron in the mitochondria (VI)
'R48' Fe(site{st_2mt}[1]), Fe(site{st_2mt}[2]), Fe(site{st_2mt}[3]), Fe(site{st_2mt}[4]), Fe(site{st_2mt}[5]), Fe(site{st_2mt}[6]), fra(site1[1] site2[2] site3[3] site4[4] site5[5] site6[6]) -> Fe(site{st_2mt}[.]), Fe(site{st_2mt}[.]), Fe(site{st_2mt}[.]), Fe(site{st_2mt}[.]), Fe(site{st_2mt}[.]), Fe(site{st_2mt}[.]), fra(site1[.] site2[.] site3[.] site4[.] site5[.] site6[.]) @ 'k48'  // Dissociation of holo-frataxin
'R49' g_isu() -> g_isu(), IScU(fra[.]) @ 'k49'  // IScU synthesis
'R50' IScU(fra[.]) -> . @ 'k50'  // ISU decay
'R51' IScU(fra[.]), fra(isu[.] site1[_] site2[_] site3[_] site4[_] site5[_] site6[_]) -> IScU(fra[1]), fra(isu[1] site1[_] site2[_] site3[_] site4[_] site5[_] site6[_]) @ 'k51'  // Holo-fra interacts with ISU
'R52' fra(isu[1]), IScU(fra[1]) -> fra(isu[.]), IScU(fra[.]) @ 'k52'  // Holo-fra-ISU dissociation
'R53' Fe(site{st_2mt}[1] site1[.]), Fe(site{st_2mt}[2] site1[.]), Fe(site{st_2mt}[3] site1[.]), Fe(site{st_2mt}[4] site1[.]), Fe(site{st_2mt}[5] site1[.]), Fe(site{st_2mt}[6] site1[.]), fra(isu[_] site1[1] site2[2] site3[3] site4[4] site5[5] site6[6]) -> Fe(site{st_2mt}[.] site1[.]), Fe(site{st_2mt}[.] site1[.]), Fe(site{st_2mt}[1] site1[.]), Fe(site{st_2mt}[1] site1[2]), Fe(site{st_2mt}[2] site1[3]), Fe(site{st_2mt}[3] site1[.]), fra(isu[_] site1[.] site2[.] site3[.] site4[.] site5[.] site6[.]) @ 'k53'  // Formation of Fe- S cluster
'R54' g_IRP() -> g_IRP(), IRP(site{m}[.]) @ 'k54'  // IRP synthesis
'R55' IRP(site{m}[.]) -> . @ 'k55'  // IRP decay
'R56' . -> ScoA(), glycine() @ 'k56'  // Random production of starting metabolites for heme synthesis
'R57' g_alas() -> g_alas(), ALAS() @ 'k57'  // ALAS synthesis
'R58' ALAS() -> . @ 'k58'  // ALAS decay
'R59' ALAS(), ScoA(), glycine() -> ALAS(), ALA(site{mt}[.]) @ 'k59'  // Heme synthesis (I)
'R60' ALA(site{mt}[.]) -> ALA(site{cy}[.]) @ 'k60'  // Heme synthesis (II)
'R61' g_pbs() -> g_pbs(), PBS() @ 'k61'  // PBS synthesis
'R62' PBS() -> . @ 'k62'  // PBS decay
'R63' PBS(), ALA(site{cy}[.]), ALA(site{cy}[.]) -> PBS(), PBG() @ 'k63'  // Heme synthesis (III)
'R64' g_pbgd() -> g_pbgd(), PBGD() @ 'k64'  // PBGD synthesis
'R65' PBGD() -> . @ 'k65'  // PBGD decay
'R66' UPD() -> . @ 'k66'  // UPD decay
'R67' CPO() -> . @ 'k67'  // CPO decay
'R68' PBGD(), PBG(), PBG(), PBG(), PBG() -> PBGD(), PUP() @ 'k68'  // Heme synthesis (IV)
'R69' g_ups() -> g_ups(), UPS() @ 'k69'  // UPS synthesis
'R70' UPS() -> . @ 'k70'  // UPS decay
'R71' UPS(), PUP() -> UPS(), UP3() @ 'k71'  // Heme synthesis (V)
