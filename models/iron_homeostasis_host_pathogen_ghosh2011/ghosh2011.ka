%init: 1 g_tf()
%init: 1 g_tfR()
%init: 1 g_dcytb()
%init: 1 g_dmt()
%init: 1 g_fer()
%init: 1 g_fp()
%init: 1 g_cp()
%init: 1 g_mf()
%init: 1 g_fra()
%init: 1 g_isu()
%init: 1 g_IRP()
%init: 1 g_alas()
%init: 1 g_pbs()
%init: 1 g_pbgd()
%init: 1 g_ups()
%init: 1 g_upd()
%init: 1 g_cpo()
%init: 1 g_ppo()
%init: 1 g_fc()
%init: 1 g_ho()
%init: 1 g_hep()
%init: 1 g_sufR(site{a}[.])
%init: 1 g_esx3(site{a}[.])
%init: 1 g_irtAB(site{a}[.])
%init: 1 g_sufS(site{a}[.])
%init: 1 g_sufE(site{a}[.])
%init: 1 g_bfr(site1{inc}[.] site2[.])
%init: 1 g_sufB(site{a}[.])
%init: 1 g_sufC(site{a}[.])
%init: 1 g_sufD(site{a}[.])
%init: 1 g_ider()
%init: 1 g_mbtCD()
