begin reaction rules

	g_tf() -> g_tf()+Tf(Fe1,Fe2~n,tfR~u) k1
	Tf(Fe1,Fe2~n,tfR~u) -> 0 k2 DeleteMolecules
	Fe(site~3ex)+Tf(Fe1,Fe2~n,tfR~u) -> Fe(site~3ex!1).Tf(Fe1!1,Fe2~n,tfR~u) k3
	Tf(Fe1!+,Fe2~n,tfR~u) -> Tf(Fe1!+,Fe2~n,tfR~a) k4
	Tf(Fe2~n,tfR~a) -> Tf(Fe2~a,tfR~a) k5
	Fe(site~3ex)+Tf(Fe2~a) -> Fe(site~3ex!1).Tf(Fe2~a!1) k6
	g_tfR() -> g_tfR()+TfR(Tf) k7
	TfR(Tf) -> 0 k8 DeleteMolecules
	Tf(Fe1!+,Fe2~a!?,tfR~a)+TfR(Tf) -> Tf(Fe1!+,Fe2~a!?,tfR~a!1).TfR(Tf!1) k9
	Tf(Fe1!+,tfR~a!1).TfR(Tf!1) -> Tf(Fe1!+,tfR~a)+TfR(Tf) k10
	Tf(Fe1!+,tfR~a!+) -> Tf(Fe1!+,tfR~inside!+) k11
	Fe(site~3ex!2).Tf(Fe1!+,Fe2~a!2,tfR~inside!+) -> Fe(site~3ed)+Tf(Fe1!+,Fe2~a,tfR~inside!+) k12
	Fe(site~3ex!2).Tf(Fe1!2,Fe2~a,tfR~inside!+) -> Fe(site~3ed)+Tf(Fe1,Fe2~a,tfR~inside!+) k13
	Tf(Fe2~a,tfR~inside!+) -> Tf(Fe2~a,tfR~out!+) k14
	Tf(Fe2~a,tfR~out!1).TfR(Tf!1) -> Tf(Fe2~n,tfR~u)+TfR(Tf) k15
	g_dcytb() -> g_dcytb()+Dcytb(site) k16
	Dcytb(site) -> 0 k17 DeleteMolecules
	Dcytb(site)+Fe(site~3ed) -> Dcytb(site!1).Fe(site~3ed!1) k18
	Dcytb(site!1).Fe(site~3ed!1) -> Dcytb(site)+Fe(site~2ed) k19
	g_dmt() -> g_dmt()+DMT(site) k20
	DMT(site) -> 0 k21 DeleteMolecules
	DMT(site)+Fe(site~2ed) -> DMT(site!1).Fe(site~2ed!1) k22
	DMT(site!1).Fe(site~2ed!1) -> DMT(site)+Fe(site~2cy) k23
	g_fer() -> g_fer()+Fer(Fe) k24
	Fer(Fe) -> 0 k25 DeleteMolecules
	Fe(site~2cy)+Fer(Fe) -> Fe(site~fer!1).Fer(Fe!1) k26
	g_fp() -> g_fp()+fp(site) k27
	fp(site) -> 0 k28 DeleteMolecules
	Fe(site~fer!1).Fer(Fe!1)+fp(site) -> Fe(site~fp!1).fp(site!1) k29 DeleteMolecules
	Fe(site~fp!1).fp(site!1) -> Fe(site~2ex)+fp(site) k30
	Fe(site~2cy)+fp(site) -> Fe(site~fp!1).fp(site!1) k31
	g_cp() -> g_cp()+Cp(site) k32
	Cp(site) -> 0 k33 DeleteMolecules
	Cp(site)+Fe(site~2ex) -> Cp(site!1).Fe(site~2ex!1) k34
	Cp(site!1).Fe(site~2ex!1) -> Cp(site)+Fe(site~3ex) k35
	g_mf() -> g_mf()+mf(site) k36
	mf(site) -> 0 k37 DeleteMolecules
	mf(site)+Fe(site~2cy) -> mf(site!1).Fe(site~2cy!1) k38
	mf(site!1).Fe(site~2cy!1) -> mf(site)+Fe(site~2mt) k39
	g_fra() -> g_fra()+fra(isu,site1,site2,site3,site4,site5,site6) k40
	fra(isu,site1,site2,site3,site4,site5,site6) -> 0 k41 DeleteMolecules
	Fe(site~2mt)+fra(site1) -> Fe(site~2mt!1).fra(site1!1) k42
	Fe(site~2mt)+fra(site2) -> Fe(site~2mt!1).fra(site2!1) k43
	Fe(site~2mt)+fra(site3) -> Fe(site~2mt!1).fra(site3!1) k44
	Fe(site~2mt)+fra(site4) -> Fe(site~2mt!1).fra(site4!1) k45
	Fe(site~2mt)+fra(site5) -> Fe(site~2mt!1).fra(site5!1) k46
	Fe(site~2mt)+fra(site6) -> Fe(site~2mt!1).fra(site6!1) k47
	Fe(site~2mt!1).Fe(site~2mt!2).Fe(site~2mt!3).Fe(site~2mt!4).Fe(site~2mt!5).Fe(site~2mt!6).fra(site1!1,site2!2,site3!3,site4!4,site5!5,site6!6) -> Fe(site~2mt)+Fe(site~2mt)+Fe(site~2mt)+Fe(site~2mt)+Fe(site~2mt)+Fe(site~2mt)+fra(site1,site2,site3,site4,site5,site6) k48 * 720.0
	g_isu() -> g_isu()+IScU(fra) k49
	IScU(fra) -> 0 k50 DeleteMolecules
	IScU(fra)+fra(isu,site1!+,site2!+,site3!+,site4!+,site5!+,site6!+) -> IScU(fra!1).fra(isu!1,site1!+,site2!+,site3!+,site4!+,site5!+,site6!+) k51
	fra(isu!1).IScU(fra!1) -> fra(isu)+IScU(fra) k52
	Fe(site~2mt!1,site1).Fe(site~2mt!2,site1).Fe(site~2mt!3,site1).Fe(site~2mt!4,site1).Fe(site~2mt!5,site1).Fe(site~2mt!6,site1).fra(isu!+,site1!1,site2!2,site3!3,site4!4,site5!5,site6!6) -> Fe(site~2mt,site1)+Fe(site~2mt,site1)+Fe(site~2mt!1,site1).Fe(site~2mt!1,site1!2).Fe(site~2mt!2,site1!3).Fe(site~2mt!3,site1)+fra(isu!+,site1,site2,site3,site4,site5,site6) k53 * 720.0
	g_IRP() -> g_IRP()+IRP(site~m) k54
	IRP(site~m) -> 0 k55 DeleteMolecules
	0 -> ScoA()+glycine() k56
	g_alas() -> g_alas()+ALAS() k57
	ALAS() -> 0 k58 DeleteMolecules
	ALAS()+ScoA()+glycine() -> ALAS()+ALA(site~mt) k59
	ALA(site~mt) -> ALA(site~cy) k60
	g_pbs() -> g_pbs()+PBS() k61
	PBS() -> 0 k62 DeleteMolecules
	PBS()+ALA(site~cy)+ALA(site~cy) -> PBS()+PBG() k63 * 2.0
	g_pbgd() -> g_pbgd()+PBGD() k64
	PBGD() -> 0 k65 DeleteMolecules
	UPD() -> 0 k66 DeleteMolecules
	CPO() -> 0 k67 DeleteMolecules
	PBGD()+PBG()+PBG()+PBG()+PBG() -> PBGD()+PUP() k68 * 24.0
	g_ups() -> g_ups()+UPS() k69
	UPS() -> 0 k70 DeleteMolecules
	UPS()+PUP() -> UPS()+UP3() k71
	UPD()+UP3() -> UPD()+CP3() k72
	CPO()+CP3() -> CPO()+PP9() k73
	PPO()+PP9() -> PPO()+P9(site) k74
	g_upd() -> g_upd()+UPD() k75
	g_cpo() -> g_cpo()+CPO() k76
	g_ppo() -> g_ppo()+PPO() k77
	PPO() -> 0 k78 DeleteMolecules
	g_fc() -> g_fc()+fc(Fe,P9,site) k79
	fc(Fe,P9,site) -> 0 k80 DeleteMolecules
	fc(Fe,P9,site)+fc(Fe,P9,site) -> fc(Fe,P9,site!1).fc(Fe,P9,site!1) k81 * 2.0
