    1 RAF_activity() ((((((((((((((((((Obs_Act_BRAF_mono+(5*Obs_Act_BRAF_act_nonact))+(10*Obs_Act_BRAF_homodimer))+(0.05*Obs_Act_RAF1_mono_off))+(0.2*Obs_Act_RAF1_mono_on))+(0.5*Obs_Act_RAF1_homodimer_off))+(1.25*Obs_Act_RAF1_homodimer_half))+(2*Obs_Act_RAF1_homodimer_on))+(15*Obs_Act_heterodimer_partial))+(30*Obs_Act_heterodimer_full))+(5*Obs_Act_BRAF_BRAF_inh))+(0.25*Obs_Act_RAF1_RAF1_inh_off))+Obs_Act_RAF1_RAF1_inh_on)+(8*Obs_Act_RAF1_off_BRAF_inh))+(8*Obs_Act_RAF1_off_inh_BRAF))+(15*Obs_Act_RAF1_on_BRAF_inh))+(15*Obs_Act_RAF1_on_inh_BRAF))+(10*Obs_Act_BRAF_KSR))+(0.5*Obs_Act_RAF1_KSR_off))+(2*Obs_Act_RAF1_KSR_on)
    2 MEK_competition() (1+(Obs_Sub_uMEK/Km_RAF_MEK_1))+(Obs_Sub_pMEK/Km_RAF_MEK_2)
