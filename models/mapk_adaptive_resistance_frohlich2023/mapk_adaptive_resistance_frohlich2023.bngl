begin functions
  # Saturating ERK-dependent transcriptional modulation.
  synthesize_pERK_DUSP_ERK_kmod()   1 + modulation_synthesize_pERK_DUSP_ERK*synthesize_pERK_DUSP_ERK_gexpslope/(modulation_synthesize_pERK_DUSP_ERK + synthesize_pERK_DUSP_ERK_kM)
  # State-dependent transcript synthesis rate.
  msynthesize_pERK_DUSP_ksyn()      1.0*msynthesize_pERK_DUSP_kbase*synthesize_pERK_DUSP_ERK_kmod
  # Saturable pEGFR-dependent internalization rate.
  catalyze_EGFR_kendo()             catalyze_EGFR_endo_kcat/(pEGFR_PM + catalyze_EGFR_deg_kM)
  # Saturating ERK-dependent transcriptional modulation.
  synthesize_pERK_EGFR_ERK_kmod()   1 + modulation_synthesize_pERK_EGFR_ERK*synthesize_pERK_EGFR_ERK_gexpslope/(modulation_synthesize_pERK_EGFR_ERK + synthesize_pERK_EGFR_ERK_kM)
  # State-dependent transcript synthesis rate.
  msynthesize_pERK_EGFR_ksyn()      msynthesize_pERK_EGFR_kbase*synthesize_pERK_EGFR_ERK_kmod*EGFR_crispr
  # Saturating ERK-dependent transcriptional modulation.
  synthesize_pERK_SPRY_ERK_kmod()   1 + modulation_synthesize_pERK_SPRY_ERK*synthesize_pERK_SPRY_ERK_gexpslope/(modulation_synthesize_pERK_SPRY_ERK + synthesize_pERK_SPRY_ERK_kM)
  # State-dependent transcript synthesis rate.
  msynthesize_pERK_SPRY_ksyn()      1.0*msynthesize_pERK_SPRY_kbase*synthesize_pERK_SPRY_ERK_kmod
  # Output mapping for tBRAF.
  tBRAF_obs()                       ln(1.0e-6*tBRAF*NA*V_ref)
  # Output mapping for tCRAF.
  tCRAF_obs()                       ln(1.0e-6*tCRAF*NA*V_ref)
  # Output mapping for tRAS.
  tRAS_obs()                        ln(1.0e-6*tRAS*NA*V_ref)
  # Output mapping for tMEK.
  tMEK_obs()                        ln(1.0e-6*tMEK*NA*V_ref)
  # Output mapping for pMEK.
  pMEK_obs()                        pMEK/tMEK
  # Output mapping for pMEK IF.
  pMEK_IF_obs()                     pMEK_obs*pMEK_IF_scale + pMEK_IF_offset
  # Output mapping for tERK.
  tERK_obs()                        ln(1.0e-6*tERK*NA*V_ref)
  # Output mapping for pERK.
  pERK_obs()                        pERK/tERK
  # Output mapping for pERK IF.
  pERK_IF_obs()                     pERK_obs*pERK_IF_scale + pERK_IF_offset
  # Output mapping for tDUSP.
  tDUSP_obs()                       ln(1.0e-6*tDUSP*NA*V_ref)
  # Output mapping for tmDUSP.
  tmDUSP_obs()                      ln(tmDUSP)
  # Output mapping for tEGF.
  tEGF_obs()                        ln(1.0e-6*tEGF*NA*V_ref)
  # Output mapping for tEGFR.
  tEGFR_obs()                       ln(1.0e-6*tEGFR*NA*V_ref)
  # Output mapping for pEGFR.
  pEGFR_obs()                       pEGFR/tEGFR
  # Output mapping for tmEGFR.
  tmEGFR_obs()                      ln(tmEGFR)
  # Output mapping for tGRB2.
  tGRB2_obs()                       ln(1.0e-6*tGRB2*NA*V_ref)
  # Output mapping for tSPRY.
  tSPRY_obs()                       ln(1.0e-6*tSPRY*NA*V_ref)
  # Output mapping for tmSPRY.
  tmSPRY_obs()                      ln(tmSPRY)
  # Output mapping for tSOS1.
  tSOS1_obs()                       ln(1.0e-6*tSOS1*NA*V_ref)
  # Output mapping for pS1134SOS1.
  pS1134SOS1_obs()                  pS1134SOS1/tSOS1
  # Output mapping for tCBL.
  tCBL_obs()                        ln(1.0e-6*tCBL*NA*V_ref)
end functions

begin energy patterns
  ep_BRAF_BRAF_mod_RAS_double:  RAS(raf!2,state~gtp).BRAF(RBD!2,raf!1).BRAF(RBD!3,raf!1).RAS(raf!3,state~gtp)    ep_RAF_RAF_mod_RASgtp_double_ddG
  ep_BRAF_CRAF_mod_RAS_double:  RAS(raf!2,state~gtp).BRAF(RBD!2,raf!1).CRAF(RBD!3,raf!1).RAS(raf!3,state~gtp)    ep_RAF_RAF_mod_RASgtp_double_ddG
  ep_CRAF_CRAF_mod_RAS_double:  RAS(raf!2,state~gtp).CRAF(RBD!2,raf!1).CRAF(RBD!3,raf!1).RAS(raf!3,state~gtp)    ep_RAF_RAF_mod_RASgtp_double_ddG
  ep_BRAF_RAF_mod_pRAF:         BRAF(raf!+,T753~p)    ep_RAF_RAF_mod_pRAF_ddG
  ep_CRAF_RAF_mod_pRAF:         CRAF(raf!+,S642~p)    ep_RAF_RAF_mod_pRAF_ddG
  ep_BRAF_RAS_mod_pRAF:         BRAF(RBD!+,T753~p)    ep_RAF_RAS_mod_pRAF_ddG
  ep_CRAF_RAS_mod_pRAF:         CRAF(RBD!+,S642~p)    ep_RAF_RAS_mod_pRAF_ddG
  ep_bind_RASgtp_BRAF:          RAS(raf!1,state~gtp).BRAF(RBD!1)    bind_RASgtp_RAF_dG
  ep_bind_RASgtp_CRAF:          RAS(raf!1,state~gtp).CRAF(RBD!1)    bind_RASgtp_RAF_dG
  ep_bind_BRAF_BRAF:            BRAF(raf!1).BRAF(raf!1)    bind_RAF_RAF_dG
  ep_bind_BRAF_CRAF:            BRAF(raf!1).CRAF(raf!1)    bind_RAF_RAF_dG
  ep_bind_CRAF_CRAF:            CRAF(raf!1).CRAF(raf!1)    bind_RAF_RAF_dG
  ep_bind_RAFi_BRAF:            RAFi(raf!1).BRAF(rafi!1)    bind_RAFi_RAF_dG
  ep_bind_RAFi_CRAF:            RAFi(raf!1).CRAF(rafi!1)    bind_RAFi_RAF_dG
  ep_BRAF_BRAF_mod_RAFi_single:  BRAF(raf!1).BRAF(raf!1,rafi!2).RAFi(raf!2)    ep_RAF_RAF_mod_RAFi_single_ddG
  ep_BRAF_CRAF_mod_RAFi_single:  BRAF(raf!1).CRAF(raf!1,rafi!2).RAFi(raf!2)    ep_RAF_RAF_mod_RAFi_single_ddG
  ep_CRAF_BRAF_mod_RAFi_single:  CRAF(raf!1).BRAF(raf!1,rafi!2).RAFi(raf!2)    ep_RAF_RAF_mod_RAFi_single_ddG
  ep_CRAF_CRAF_mod_RAFi_single:  CRAF(raf!1).CRAF(raf!1,rafi!2).RAFi(raf!2)    ep_RAF_RAF_mod_RAFi_single_ddG
  ep_BRAF_BRAF_mod_RAFi_double:  RAFi(raf!2).BRAF(raf!1,rafi!2).BRAF(raf!1,rafi!3).RAFi(raf!3)    ep_RAF_RAF_mod_RAFi_double_Gf
  ep_BRAF_CRAF_mod_RAFi_double:  RAFi(raf!2).BRAF(raf!1,rafi!2).CRAF(raf!1,rafi!3).RAFi(raf!3)    ep_RAF_RAF_mod_RAFi_double_Gf
  ep_CRAF_CRAF_mod_RAFi_double:  RAFi(raf!2).CRAF(raf!1,rafi!2).CRAF(raf!1,rafi!3).RAFi(raf!3)    ep_RAF_RAF_mod_RAFi_double_Gf
  ep_bind_BRAF_uMEK:            BRAF(mek!1).MEK(phospho~u,raf!1)    bind_RAF_uMEK_dG
  ep_bind_CRAF_uMEK:            CRAF(mek!1).MEK(phospho~u,raf!1)    bind_RAF_uMEK_dG
  ep_bind_EGF_EGFR:             EGF(rtk!1).EGFR(rtkf!1)    bind_EGF_EGFR_dG
  ep_bind_EGFR_EGFR:            EGFR(KD!1).EGFR(Tyr!1)    bind_EGFR_EGFR_dG
  ep_EGFR_EGFR_EGF:             EGF(rtk!1).EGFR(KD!+,rtkf!1)    ep_EGFR_EGFR_mod_EGF_single_ddG
  ep_bind_pEGFR_GRB2:           EGFR(Tyr!1).GRB2(SH2!1)    bind_pEGFR_GRB2_dG
  ep_bind_SPRY_GRB2:            SPRY(SH3m!1).GRB2(SH3!1)    bind_SPRY_GRB2_dG
  ep_bind_GRB2_SOS1:            GRB2(SH3!1).SOS1(SH3m!1)    bind_GRB2_SOS1_dG
  ep_SOS1S1134p_GRB2_single:    SOS1(S1134~p,SH3m!1).GRB2(SH3!1)    ep_SOS1S1134p_GRB2_ddG
  ep_bind_CBL_GRB2:             CBL(SH3m!1).GRB2(SH3!1)    bind_CBL_GRB2_dG
  ep_bind_DUSP_pERK:            DUSP(erk!1).ERK(CD!1,phospho~p)    bind_DUSP_pERK_dG
  ep_bind_MEK_uERK:             MEK(Dsite!1).ERK(CD!1,phospho~u)    bind_MEK_uERK_dG
end energy patterns

begin reaction rules
  # RASgtp and BRAF bind and dissociate.
  RASgtp_and_BRAF_bind_and_dissociate:       RAS(raf,state~gtp) + BRAF(RBD) <-> RAS(raf!1,state~gtp).BRAF(RBD!1)    Arrhenius(bind_RASgtp_RAF_phi, Ea0_bind_RASgtp_BRAF)
  # RASgtp and CRAF bind and dissociate.
  RASgtp_and_CRAF_bind_and_dissociate:       RAS(raf,state~gtp) + CRAF(RBD) <-> RAS(raf!1,state~gtp).CRAF(RBD!1)    Arrhenius(bind_RASgtp_RAF_phi, Ea0_bind_RASgtp_CRAF)
  # BRAF and BRAF bind and dissociate.
  BRAF_and_BRAF_bind_and_dissociate:         BRAF(raf) + BRAF(raf) <-> BRAF(raf!1).BRAF(raf!1)    Arrhenius(bind_RAF_RAF_phi, Ea0_bind_RAF_RAF)
  # BRAF and CRAF bind and dissociate.
  BRAF_and_CRAF_bind_and_dissociate:         BRAF(raf) + CRAF(raf) <-> BRAF(raf!1).CRAF(raf!1)    Arrhenius(bind_RAF_RAF_phi, Ea0_bind_RAF_RAF)
  # CRAF and CRAF bind and dissociate.
  CRAF_and_CRAF_bind_and_dissociate:         CRAF(raf) + CRAF(raf) <-> CRAF(raf!1).CRAF(raf!1)    Arrhenius(bind_RAF_RAF_phi, Ea0_bind_RAF_RAF)
  # RAFi and BRAF bind and dissociate.
  RAFi_and_BRAF_bind_and_dissociate:         RAFi(raf) + BRAF(rafi) <-> RAFi(raf!1).BRAF(rafi!1)    Arrhenius(bind_RAFi_RAF_phi, Ea0_bind_RAFi_RAF)
  # RAFi and CRAF bind and dissociate.
  RAFi_and_CRAF_bind_and_dissociate:         RAFi(raf) + CRAF(rafi) <-> RAFi(raf!1).CRAF(rafi!1)    Arrhenius(bind_RAFi_RAF_phi, Ea0_bind_RAFi_RAF)
  # BRAF and uMEK bind and dissociate.
  BRAF_and_uMEK_bind_and_dissociate:         BRAF(mek) + MEK(phospho~u,raf) <-> BRAF(mek!1).MEK(phospho~u,raf!1)    Arrhenius(bind_RAF_uMEK_phi, Ea0_bind_BRAF_uMEK)
  # CRAF and uMEK bind and dissociate.
  CRAF_and_uMEK_bind_and_dissociate:         CRAF(mek) + MEK(phospho~u,raf) <-> CRAF(mek!1).MEK(phospho~u,raf!1)    Arrhenius(bind_RAF_uMEK_phi, Ea0_bind_CRAF_uMEK)
  # BRAF BRAF phosphorylates MEK.
  BRAF_BRAF_phosphorylates_MEK:              MEK(phospho~u,raf!1).BRAF(RBD!+,mek!1,raf!2,rafi).BRAF(RBD!+,raf!2) -> MEK(phospho~p,raf) + BRAF(RBD!+,mek,raf!2,rafi).BRAF(RBD!+,raf!2)    catalyze_RAF_RAFrafiNone_MEK_p_kcat
  # BRAF CRAF phosphorylates MEK.
  BRAF_CRAF_phosphorylates_MEK:              MEK(phospho~u,raf!1).BRAF(RBD!+,mek!1,raf!2,rafi).CRAF(RBD!+,raf!2) -> MEK(phospho~p,raf) + BRAF(RBD!+,mek,raf!2,rafi).CRAF(RBD!+,raf!2)    catalyze_RAF_RAFrafiNone_MEK_p_kcat
  # CRAF BRAF phosphorylates MEK.
  CRAF_BRAF_phosphorylates_MEK:              MEK(phospho~u,raf!1).CRAF(RBD!+,mek!1,raf!2,rafi).BRAF(RBD!+,raf!2) -> MEK(phospho~p,raf) + CRAF(RBD!+,mek,raf!2,rafi).BRAF(RBD!+,raf!2)    catalyze_RAF_RAFrafiNone_MEK_p_kcat
  # CRAF CRAF phosphorylates MEK.
  CRAF_CRAF_phosphorylates_MEK:              MEK(phospho~u,raf!1).CRAF(RBD!+,mek!1,raf!2,rafi).CRAF(RBD!+,raf!2) -> MEK(phospho~p,raf) + CRAF(RBD!+,mek,raf!2,rafi).CRAF(RBD!+,raf!2)    catalyze_RAF_RAFrafiNone_MEK_p_kcat
  # BRAFV600E phosphorylates MEK unbound1.
  BRAFV600E_phosphorylates_MEK_unbound1:     MEK(meki,phospho~u,raf!1).BRAF(AA600~E,mek!1,raf,rafi) -> MEK(meki,phospho~p,raf) + BRAF(AA600~E,mek,raf,rafi)    catalyze_RAFrafiNone_MEKmekiNone_p_kcat
  # BRAFV600E phosphorylates MEK unbound2.
  BRAFV600E_phosphorylates_MEK_unbound2:     MEK(meki,phospho~u,raf!1).BRAF(AA600~E,RBD,mek!1,raf!+,rafi) -> MEK(meki,phospho~p,raf) + BRAF(AA600~E,RBD,mek,raf!+,rafi)    catalyze_RAFrafiNone_MEKmekiNone_p_kcat
  # BRAFV600E phosphorylates MEK unbound3.
  BRAFV600E_phosphorylates_MEK_unbound3:     MEK(meki,phospho~u,raf!1).BRAF(AA600~E,RBD!+,mek!1,raf!2,rafi).BRAF(RBD,raf!2) -> MEK(meki,phospho~p,raf) + BRAF(AA600~E,RBD!+,mek,raf!2,rafi).BRAF(RBD,raf!2)    catalyze_RAFrafiNone_MEKmekiNone_p_kcat
  # BRAFV600E phosphorylates MEK unbound4.
  BRAFV600E_phosphorylates_MEK_unbound4:     MEK(meki,phospho~u,raf!1).BRAF(AA600~E,RBD!+,mek!1,raf!2,rafi).CRAF(RBD,raf!2) -> MEK(meki,phospho~p,raf) + BRAF(AA600~E,RBD!+,mek,raf!2,rafi).CRAF(RBD,raf!2)    catalyze_RAFrafiNone_MEKmekiNone_p_kcat
  # MEK is dephosphorylated.
  MEK_is_dephosphorylated:                   MEK(phospho~p) -> MEK(phospho~u)    catalyze_PP2A_MEK_u_kcat()
  # bind MEK uERK.
  bind_MEK_uERK:                             MEK(Dsite) + ERK(CD,phospho~u) <-> MEK(Dsite!1).ERK(CD!1,phospho~u)    Arrhenius(bind_MEK_uERK_phi, Ea0_bind_MEK_uERK)
  # pMEK phosphorylates ERK.
  pMEK_phosphorylates_ERK:                   ERK(CD!1,phospho~u).MEK(Dsite!1,meki,phospho~p) -> ERK(CD,phospho~p) + MEK(Dsite,meki,phospho~p)    catalyze_MEKmekiNone_phosphop_ERK_p_kcat
  # bind DUSP pERK.
  bind_DUSP_pERK:                            DUSP(erk) + ERK(CD,phospho~p) <-> DUSP(erk!1).ERK(CD!1,phospho~p)    Arrhenius(bind_DUSP_pERK_phi, Ea0_bind_DUSP_pERK)
  # DUSP dephosphorylates ERK.
  DUSP_dephosphorylates_ERK:                 ERK(CD!1,phospho~p).DUSP(erk!1) -> ERK(CD,phospho~u) + DUSP(erk)    catalyze_DUSP_ERK_u_kcat()
  # synthesis mDUSP.
  synthesis_mDUSP:                           0 -> mDUSP()@CP    msynthesize_pERK_DUSP_ksyn()
  # basal degradation mDUSP.
  basal_degradation_mDUSP:                   mDUSP() -> 0    msynthesize_pERK_DUSP_kdeg DeleteMolecules
  # synthesis pDUSP.
  synthesis_pDUSP:                           mDUSP()@CP -> mDUSP()@CP + DUSP(erk)@CP    psynthesize_pERK_DUSP_ksyn()
  # basal degradation pDUSP.
  basal_degradation_pDUSP:                   DUSP() -> 0    psynthesize_pERK_DUSP_kdeg DeleteMolecules
  # EGF and EGFR bind and dissociate.
  EGF_and_EGFR_bind_and_dissociate:          EGF(rtk) + EGFR(rtkf) <-> EGF(rtk!1).EGFR(rtkf!1)    Arrhenius(bind_EGF_EGFR_phi, Ea0_bind_EGF_EGFR)
  # bind EGFR EGFRu.
  bind_EGFR_EGFRu:                           EGFR(KD,Tyr~u) + EGFR(KD,Tyr~u) <-> EGFR(KD!1,Tyr~u).EGFR(KD,Tyr~u!1)    Arrhenius(bind_EGFR_EGFR_phi, Ea0_bind_EGFR_EGFR)
  # bind EGFR EGFRp.
  bind_EGFR_EGFRp:                           EGFR(KD,Tyr~p) + EGFR(KD,Tyr~u) <-> EGFR(KD!1,Tyr~p).EGFR(KD,Tyr~u!1)    Arrhenius(bind_EGFR_EGFR_phi, Ea0_bind_EGFR_EGFR)
  # catalyze EGFR EGFR p.
  catalyze_EGFR_EGFR_p:                      EGFR(KD!1,rtkf!+).EGFR(Tyr~u!1) -> EGFR(KD,rtkf!+) + EGFR(Tyr~p)    catalyze_EGFR_EGFR_p_kcat
  # catalyze EGFR u.
  catalyze_EGFR_u:                           EGFR(Tyr~p) -> EGFR(Tyr~u)    catalyze_EGFR_u_kcat()
  # pEGFR is endocytosed.
  pEGFR_is_endocytosed:                      EGFR(Tyr~p)@PM -> EGFR(Tyr~p)@EM    catalyze_EGFR_kendo() MoveConnected
  # EGFR is recycled.
  EGFR_is_recycled:                          EGFR()@EM -> EGFR()@PM    catalyze_EGFR_recycl_kcat MoveConnected
  # ubEGFR is degraded.
  ubEGFR_is_degraded:                        EGFR(ub~true)@EM -> 0    catalyze_EGFR_deg_kcat DeleteMolecules
  # synthesis mEGFR.
  synthesis_mEGFR:                           0 -> mEGFR()@PM    msynthesize_pERK_EGFR_ksyn()
  # basal degradation mEGFR.
  basal_degradation_mEGFR:                   mEGFR() -> 0    msynthesize_pERK_EGFR_kdeg DeleteMolecules
  # synthesis pEGFR.
  synthesis_pEGFR:                           mEGFR()@PM -> mEGFR()@PM + EGFR(KD,Tyr~u,rtkf,ub~false)@PM    psynthesize_pERK_EGFR_ksyn()
  # basal degradation pEGFR.
  basal_degradation_pEGFR:                   EGFR() -> 0    psynthesize_pERK_EGFR_kdeg DeleteMolecules
  # bind pEGFR GRB2.
  bind_pEGFR_GRB2:                           GRB2(SH2) + EGFR(Tyr~p) <-> GRB2(SH2!1).EGFR(Tyr~p!1)    Arrhenius(bind_pEGFR_GRB2_phi, Ea0_bind_pEGFR_GRB2)
  # SPRY and GRB2 bind and dissociate.
  SPRY_and_GRB2_bind_and_dissociate:         SPRY(SH3m) + GRB2(SH3) <-> SPRY(SH3m!1).GRB2(SH3!1)    Arrhenius(bind_SPRY_GRB2_phi, Ea0_bind_SPRY_GRB2)
  # synthesis mSPRY.
  synthesis_mSPRY:                           0 -> mSPRY()@CP    msynthesize_pERK_SPRY_ksyn()
  # basal degradation mSPRY.
  basal_degradation_mSPRY:                   mSPRY() -> 0    msynthesize_pERK_SPRY_kdeg DeleteMolecules
  # synthesis pSPRY.
  synthesis_pSPRY:                           mSPRY()@CP -> mSPRY()@CP + SPRY(SH3m)@CP    psynthesize_pERK_SPRY_ksyn()
  # basal degradation pSPRY.
  basal_degradation_pSPRY:                   SPRY() -> 0    psynthesize_pERK_SPRY_kdeg DeleteMolecules
  # SOS1 is dephosphorylated.
  SOS1_is_dephosphorylated:                  SOS1(S1134~p) -> SOS1(S1134~u)    catalyze_phosphatase_SOS1_uS1134_kcat()
  # GRB2 and SOS1 bind and dissociate.
  GRB2_and_SOS1_bind_and_dissociate:         GRB2(SH3) + SOS1(SH3m) <-> GRB2(SH3!1).SOS1(SH3m!1)    Arrhenius(bind_GRB2_SOS1_phi, Ea0_bind_GRB2_SOS1)
  # SOS1 is phosphorylated.
  SOS1_is_phosphorylated:                    SOS1(S1134~u) -> SOS1(S1134~p)    catalyze_pERK_SOS1_pS1134_kbase
  # pERK phosphorylates SOS1.
  pERK_phosphorylates_SOS1:                  ERK(phospho~p) + SOS1(S1134~u) -> ERK(phospho~p) + SOS1(S1134~p)    catalyze_pERK_SOS1_pS1134_kcat
  # pERK phosphorylates CRAF.
  pERK_phosphorylates_CRAF:                  ERK(phospho~p) + CRAF(raf,S642~u) -> ERK(phospho~p) + CRAF(raf,S642~p)    catalyze_pERK_CRAF_pS642_kcat
  # CRAF is dephosphorylated.
  CRAF_is_dephosphorylated:                  CRAF(raf,S642~p) -> CRAF(raf,S642~u)    catalyze_phosphatase_CRAF_uS642_kcat()
  # pERK phosphorylates BRAF.
  pERK_phosphorylates_BRAF:                  ERK(phospho~p) + BRAF(raf,T753~u) -> ERK(phospho~p) + BRAF(raf,T753~p)    catalyze_pERK_BRAF_pT753_kcat
  # BRAF is dephosphorylated.
  BRAF_is_dephosphorylated:                  BRAF(raf,T753~p) -> BRAF(raf,T753~u)    catalyze_phosphatase_BRAF_uT753_kcat()
  # RTK and GRB2 bound SOS1 binds RASgdp.
  RTK_and_GRB2_bound_SOS1_binds_RASgdp:      GRB2(SH2!+,SH3!1).SOS1(SH3m!1,ras) + RAS(sos1,state~gdp) -> GRB2(SH2!+,SH3!1).SOS1(SH3m!1,ras!2).RAS(sos1!2,state~gdp)    bind_SOS1_RAS_kf
  # SOS1 dissociates from RAS.
  SOS1_dissociates_from_RAS:                 SOS1(ras!1).RAS(sos1!1) -> SOS1(ras) + RAS(sos1)    bind_SOS1_RAS_kr()
  # SOS1 catalyzes RAS guanosine exchange.
  SOS1_catalyzes_RAS_guanosine_exchange:     SOS1(ras!1).RAS(sos1!1,state~gdp) -> SOS1(ras) + RAS(sos1,state~gtp)    catalyze_SOS1_RAS_gtp_kcat
  # RAS hydrolysis GTP.
  RAS_hydrolysis_GTP:                        RAS(raf,state~gtp) -> RAS(raf,state~gdp)    catalyze_NF1_RAS_gdp_kcat()
  # GTP hydrolysis dissociates BRAF from RAS.
  GTP_hydrolysis_dissociates_BRAF_from_RAS:  RAS(raf!1,state~gtp).BRAF(RBD!1) -> RAS(raf,state~gdp) + BRAF(RBD)    catalyze_NF1_RAS_gdp_kcat()
  # GTP hydrolysis dissociates CRAF from RAS.
  GTP_hydrolysis_dissociates_CRAF_from_RAS:  RAS(raf!1,state~gtp).CRAF(RBD!1) -> RAS(raf,state~gdp) + CRAF(RBD)    catalyze_NF1_RAS_gdp_kcat()
  # CBL and GRB2 bind and dissociate.
  CBL_and_GRB2_bind_and_dissociate:          CBL(SH3m) + GRB2(SH3) <-> CBL(SH3m!1).GRB2(SH3!1)    Arrhenius(bind_CBL_GRB2_phi, Ea0_bind_CBL_GRB2)
  # catalyze CBL EGFR ub.
  catalyze_CBL_EGFR_ub:                      EGFR(ub~false).CBL() -> EGFR(ub~true).CBL()    catalyze_CBL_EGFR_ub_kcat
  # catalyze EGFR dub.
  catalyze_EGFR_dub:                         EGFR(ub~true) -> EGFR(ub~false)    catalyze_EGFR_dub_kcat()
end reaction rules

end model

begin actions
  # Vemurafenib-adapted EGF pulse; ODE is the source model's simulation mode.
  # The explicit adapted state avoids repeating the costly 24 h pre-equilibration.

  #@protocol: 100 ng/mL EGF pulse after 24 h adaptation to 1 uM vemurafenib

  #@figure: Fig. 2A in Fröhlich et al. (2023)

  generate_network({overwrite=>1})  # 1612 species, 17516 reactions
  simulate({method=>"ode",suffix=>"ode",t_start=>0,t_end=>2,n_steps=>200,\
    print_functions=>1,atol=>1e-11,rtol=>1e-9})
end actions
