  initGRB2                                   1000000.0*GRB2_0/(NA*V_ref)  # uM
  initSOS1                                   1000000.0*SOS1_0/(NA*V_ref)  # uM
  initCBL                                    1000000.0*CBL_0/(NA*V_ref)  # uM
end parameters

begin compartments
  # Unit-size topological compartments from the source PySB model; V_ref is
  # the physical cell volume used by all molecule-to-concentration conversions.
  EC  3  1.0
  PM  2  1.0  EC
  CP  3  1.0  PM
  EM  2  1.0  CP
end compartments

begin molecule types
  # BRAF(V600E) kinase with RAS, MEK, RAF-dimer, inhibitor, and feedback sites.
  BRAF(AA600~E,RBD,mek,raf,rafi,T753~u~p)
  # CRAF kinase with RAS, MEK, RAF-dimer, inhibitor, and feedback sites.
  CRAF(RBD,mek,raf,rafi,S642~u~p)
  # RAS nucleotide state and binding sites for SOS1 and RAF.
  RAS(raf,sos1,state~gdp~gtp)
  # Vemurafenib, represented as a generic ATP-competitive RAF inhibitor.
  RAFi(raf)
  # Pan-RAF inhibitor type retained from the source type system; absent here.
  PRAFi(raf)
  # MEK kinase with RAF, ERK, and inhibitor interaction sites.
  MEK(Dsite,meki,phospho~p~u,raf)
  # MEK inhibitor type retained from the source type system; absent here.
  MEKi(mek)
  # ERK kinase with MEK/DUSP docking and phosphorylation state.
  ERK(CD,phospho~p~u)
  # ERK-induced dual-specificity phosphatase.
  DUSP(erk)
  # DUSP transcript in FPKM units.
  mDUSP()
  # Fixed extracellular EGF input.
  EGF(rtk)
  # EGFR with ligand, dimerization, phosphorylation, and ubiquitin states.
  EGFR(KD,Tyr~p~u,rtkf,ub~false~true)
  # EGFR transcript in FPKM units.
  mEGFR()
  # GRB2 adaptor with SH2 and SH3 interaction sites.
  GRB2(SH2,SH3)
  # ERK-induced SPRY feedback inhibitor.
  SPRY(SH3m)
  # SPRY transcript in FPKM units.
  mSPRY()
  # SOS1 exchange factor with feedback phosphorylation and RAS binding.
  SOS1(S1134~p~u,SH3m,ras)
  # CBL ubiquitin ligase recruited through GRB2.
  CBL(SH3m)
end molecule types

