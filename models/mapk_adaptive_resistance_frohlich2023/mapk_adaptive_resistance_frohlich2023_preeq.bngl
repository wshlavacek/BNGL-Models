  catalyze_pERK_CRAF_pS642_kcat              16476.188075697737  # /h
  catalyze_pERK_BRAF_pT753_kcat              70.086482213675964  # /h
  catalyze_phosphatase_CRAF_uS642_kcatr      0.0011959607351606999  # dimensionless
