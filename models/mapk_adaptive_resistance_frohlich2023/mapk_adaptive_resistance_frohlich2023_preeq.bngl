  catalyze_EGFR_recycl_kcat                  1386.3395435837365  # /h
  catalyze_EGFR_deg_kcat                     280.29166504322831  # /h
  bind_GRB2_SOS1_kf                          30385.865566380358  # /uM/h
  bind_GRB2_SOS1_dG                          -5.3087942447554273  # dimensionless
  bind_GRB2_SOS1_phi                         0  # dimensionless
  bind_SOS1_RAS_kf                           374481.43973849952  # /uM/h
  bind_SOS1_RAS_dG                           -5.438518111982285  # dimensionless
