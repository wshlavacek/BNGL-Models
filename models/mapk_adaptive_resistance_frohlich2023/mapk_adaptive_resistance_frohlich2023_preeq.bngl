  psynthesize_pERK_SPRY_ksyn                 psynthesize_pERK_SPRY_kbase  # uM/FPKM/h
  Ea0_bind_GRB2_SOS1                         -ln(bind_GRB2_SOS1_kf) - bind_GRB2_SOS1_dG*bind_GRB2_SOS1_phi  # dimensionless
