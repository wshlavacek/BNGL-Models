  bind_RAF_uMEK_kf                           1168.0216446773491  # /uM/h
  bind_RAF_uMEK_dG                           -4.52490216776234  # dimensionless
  bind_RAF_uMEK_phi                          0  # dimensionless
  catalyze_RAF_RAFrafiNone_MEK_p_kcat        11702.957751517424  # /h
  catalyze_RAFrafiNone_MEKmekiNone_p_kcat    422.10086658396273  # /h
  catalyze_PP2A_MEK_u_kcatr                  0.0061331153577737002  # dimensionless
