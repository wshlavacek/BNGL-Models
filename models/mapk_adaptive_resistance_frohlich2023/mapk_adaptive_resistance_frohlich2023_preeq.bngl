  ep_RAF_RAF_mod_RASgtp_double_ddG           -22.994307063805536  # dimensionless
  bind_RAFi_RAF_kf                           1.44313736835185  # /uM/h
  bind_RAFi_RAF_dG                           -3.8342770796809642  # dimensionless
