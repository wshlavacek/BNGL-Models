  bind_RAF_RAF_dG                            3.7614090351321599  # dimensionless
  bind_RAF_RAF_phi                           0  # dimensionless
  bind_RASgtp_RAF_kf                         58472.336475601638  # /uM/h
  bind_RASgtp_RAF_dG                         -3.9814457167799482  # dimensionless
