begin functions
    1 synthesize_pERK_DUSP_ERK_kmod() 1+((modulation_synthesize_pERK_DUSP_ERK*synthesize_pERK_DUSP_ERK_gexpslope)/(modulation_synthesize_pERK_DUSP_ERK+synthesize_pERK_DUSP_ERK_kM))
    2 msynthesize_pERK_DUSP_ksyn() (1.0*msynthesize_pERK_DUSP_kbase)*synthesize_pERK_DUSP_ERK_kmod
    3 catalyze_EGFR_kendo() catalyze_EGFR_endo_kcat/(pEGFR_PM+catalyze_EGFR_deg_kM)
    4 synthesize_pERK_EGFR_ERK_kmod() 1+((modulation_synthesize_pERK_EGFR_ERK*synthesize_pERK_EGFR_ERK_gexpslope)/(modulation_synthesize_pERK_EGFR_ERK+synthesize_pERK_EGFR_ERK_kM))
    5 msynthesize_pERK_EGFR_ksyn() (msynthesize_pERK_EGFR_kbase*synthesize_pERK_EGFR_ERK_kmod)*EGFR_crispr
    6 synthesize_pERK_SPRY_ERK_kmod() 1+((modulation_synthesize_pERK_SPRY_ERK*synthesize_pERK_SPRY_ERK_gexpslope)/(modulation_synthesize_pERK_SPRY_ERK+synthesize_pERK_SPRY_ERK_kM))
    7 msynthesize_pERK_SPRY_ksyn() (1.0*msynthesize_pERK_SPRY_kbase)*synthesize_pERK_SPRY_ERK_kmod
    8 tBRAF_obs() ln((((1.0e-6*tBRAF)*NA)*V_ref))
    9 tCRAF_obs() ln((((1.0e-6*tCRAF)*NA)*V_ref))
   10 tRAS_obs() ln((((1.0e-6*tRAS)*NA)*V_ref))
