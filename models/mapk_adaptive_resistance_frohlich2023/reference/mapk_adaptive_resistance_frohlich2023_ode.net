   12 pMEK_obs() pMEK/tMEK
   13 pMEK_IF_obs() (pMEK_obs*pMEK_IF_scale)+pMEK_IF_offset
   14 tERK_obs() ln((((1.0e-6*tERK)*NA)*V_ref))
   15 pERK_obs() pERK/tERK
   16 pERK_IF_obs() (pERK_obs*pERK_IF_scale)+pERK_IF_offset
