begin model

#@title: Ste5-Fus3-Ptc1 phosphorylation switch (Malleshaiah et al., 2010)

#@description: |
#  Deterministic concentration model of the mating-decision circuit formed by
#  the Ste5 scaffold, Fus3 kinase, and Ptc1 phosphatase in budding yeast. Fus3
#  and Ptc1 compete for a docking site on Ste5 and then bind a catalytic site;
#  either docking bond may break while the enzyme remains catalytic-site-bound.
#  Fus3 docking affinity increases with Ste5 phosphorylation. Alpha-factor
#  recruits Ptc1 and creates a small active cytosolic Fus3 pool through fitted
#  Hill functions. Ste5 carries 1 identical phosphorylation
#  site.
#
#  This is the molar-association-units interpretation; one-site variant. A Ste5
#  internal state stores only the number of phosphorylated identical sites,
#  exactly as in the 38-equation (four-site) or 14-equation (one-site) state
#  aggregation in the supplement. The model is concentration-based in nM and is
#  intended for deterministic ODE use. The source gives no reactor volume;
#  V_ref is a conversion-only nominal yeast-cell volume and does not enter the
#  ODEs.

#@keyword: |
#  yeast mating, Ste5, Fus3, Ptc1, scaffold, multisite phosphorylation,
#  zero-order ultrasensitivity, steric hindrance, enzyme competition,
#  two-stage binding, rule-based model, ordinary differential equations

#@reference: |
#  Malleshaiah MK, Shahrezaei V, Swain PS, Michnick SW (2010). The scaffold
#  protein Ste5 directly controls a switch-like mating decision in yeast.
#  Nature 465:101-105. doi:10.1038/nature08946

#@note: |
#  This bracketed reading treats the three association-unit labels in
#  Supplementary Table 3 as /M/s and converts them to /nM/s. It is physically
#  distinct from the literal table reading and is shipped because the reported
#  units and Fig. 3b cannot both be recovered from the supplied equations and
#  values. The displayed Fus3_Ste5n_2 loss term uses k(P); it is encoded with
#  k(K) because both matching gain terms and Fig. 23b use k(K), while mixing
#  the two would violate conservation.

begin parameters

  # Population-conversion constants. V_ref is a nominal 40 fL yeast-cell
  # volume used only to make this concentration model conversion-ready.
  NA 6.02214076e23  # molecules/mol
  V_ref 4e-14       # L/cell

  # Alpha-factor input and protein concentrations (Supplementary Table 3)
  F 0.2                 # dimensionless; PCA calibration, unused in Fig. 3b
  alpha 1             # nM
  Ste5_tot 52         # nM
  Fus3_tot 197        # nM
  Ptc1_max 39         # nM
  EC50_P 240          # nM
  nH_P 2.3            # dimensionless
  Ptc1_0 1.2          # nM
  Fus3active_max 5.8  # nM
  EC50_K 1680         # nM
  nH_K 1.3            # dimensionless

  # Ptc1 two-stage docking, catalytic-site binding, and catalysis
  f1_P 0.000186  # /nM/s
  f2_P 327             # /s
  f3_P 0.3             # /s
  b1_P 22              # /s
  b2_P 0.12            # /s
  k_P 0.5              # /s

  # Fus3 two-stage docking, catalytic-site binding, and catalysis
  f1_K 1.2e-05  # /nM/s
  f2_K 850             # /s
  f3_K 0.1             # /s
  f4_K 0.000109  # /nM/s
  b1_K 99              # /s; Ste5 p0
  b2_K 42              # /s; Ste5 p1
  b3_K 21              # /s; Ste5 p2
  b4_K 13              # /s; Ste5 p3
  b5_K 10              # /s; Ste5 p4 (unused in one-site variant)
  b6_K 24              # /s
  k_K 1.13             # /s

  # Alpha-factor-dependent inputs (Supplementary Information, Eqs. on p. 17)
  Ptc1_input Ptc1_0+Ptc1_max*alpha^nH_P/(alpha^nH_P+EC50_P^nH_P)  # nM
  Fus3active_input Fus3active_max*alpha^nH_K/(alpha^nH_K+EC50_K^nH_K)  # nM
  Fus3inactive_input Fus3_tot-Fus3active_input  # nM

end parameters

begin molecule types

  Fus3(dock,cat)
  Fus3a(cat)
  Ptc1(dock,cat)
  Ste5(dock,cat,n~p0~p1)

end molecule types

begin seed species

  Fus3(dock,cat) Fus3inactive_input  # nM
  Fus3a(cat) Fus3active_input        # nM
  Ptc1(dock,cat) Ptc1_input          # nM
  Ste5(dock,cat,n~p0) Ste5_tot       # nM

end seed species

begin observables

  # Total Ste5 in each phosphorylation-count state, including complexes
  Molecules Ste5_p0 Ste5(n~p0)
  Molecules Ste5_p1 Ste5(n~p1)

  # Total Fus3-Ste5 and Ptc1-Ste5 complexes through either binding stage
  Molecules Fus3_docked Fus3(dock!+)
  Molecules Fus3_site_only Fus3(dock,cat!+)
  Molecules Ptc1_docked Ptc1(dock!+)
  Molecules Ptc1_site_only Ptc1(dock,cat!+)

end observables

begin functions

  # Mean number of phosphorylated sites per Ste5 molecule
  Mean_pSites() (Ste5_p1)/Ste5_tot

  # PCA-model complex totals: docked plus catalytic-site-only complexes
  Fus3_Ste5() Fus3_docked+Fus3_site_only
  Ptc1_Ste5() Ptc1_docked+Ptc1_site_only

end functions

begin reaction rules

  bind_Fus3_dock: Fus3(dock,cat)+Ste5(dock,cat) -> Fus3(dock!1,cat).Ste5(dock!1,cat) f1_K
  release_Fus3_dock_p0: Fus3(dock!1,cat).Ste5(dock!1,cat,n~p0) -> \
    Fus3(dock,cat)+Ste5(dock,cat,n~p0) b1_K
  release_Fus3_dock_p1: Fus3(dock!1,cat).Ste5(dock!1,cat,n~p1) -> \
    Fus3(dock,cat)+Ste5(dock,cat,n~p1) b2_K
  bind_Fus3_site_p0: Fus3(dock!1,cat).Ste5(dock!1,cat,n~p0) -> \
    Fus3(dock!1,cat!2).Ste5(dock!1,cat!2,n~p0) 1*f2_K
  release_Fus3_site_p0: Fus3(dock!1,cat!2).Ste5(dock!1,cat!2,n~p0) -> \
    Fus3(dock!1,cat).Ste5(dock!1,cat,n~p0) b6_K
  release_Fus3_dock_from_site_p0: Fus3(dock!1,cat!2).Ste5(dock!1,cat!2,n~p0) -> \
    Fus3(dock,cat!2).Ste5(dock,cat!2,n~p0) b1_K
  rebind_Fus3_dock_p0: Fus3(dock,cat!1).Ste5(dock,cat!1,n~p0) -> \
    Fus3(dock!2,cat!1).Ste5(dock!2,cat!1,n~p0) f3_K
  phosphorylate_docked_Fus3_p0: Fus3(dock!1,cat!2).Ste5(dock!1,cat!2,n~p0) -> \
    Fus3(dock!1,cat).Ste5(dock!1,cat,n~p1) k_K
  phosphorylate_site_only_Fus3_p0: Fus3(dock,cat!1).Ste5(dock,cat!1,n~p0) -> \
    Fus3(dock,cat)+Ste5(dock,cat,n~p1) k_K
  bind_Ptc1_dock: Ptc1(dock,cat)+Ste5(dock,cat) -> Ptc1(dock!1,cat).Ste5(dock!1,cat) f1_P
  release_Ptc1_dock_p0: Ptc1(dock!1,cat).Ste5(dock!1,cat,n~p0) -> \
    Ptc1(dock,cat)+Ste5(dock,cat,n~p0) b1_P
  release_Ptc1_dock_p1: Ptc1(dock!1,cat).Ste5(dock!1,cat,n~p1) -> \
    Ptc1(dock,cat)+Ste5(dock,cat,n~p1) b1_P
  bind_Ptc1_site_p1: Ptc1(dock!1,cat).Ste5(dock!1,cat,n~p1) -> \
    Ptc1(dock!1,cat!2).Ste5(dock!1,cat!2,n~p1) 1*f2_P
  release_Ptc1_site_p1: Ptc1(dock!1,cat!2).Ste5(dock!1,cat!2,n~p1) -> \
    Ptc1(dock!1,cat).Ste5(dock!1,cat,n~p1) b2_P
  release_Ptc1_dock_from_site_p1: Ptc1(dock!1,cat!2).Ste5(dock!1,cat!2,n~p1) -> \
    Ptc1(dock,cat!2).Ste5(dock,cat!2,n~p1) b1_P
  rebind_Ptc1_dock_p1: Ptc1(dock,cat!1).Ste5(dock,cat!1,n~p1) -> \
    Ptc1(dock!2,cat!1).Ste5(dock!2,cat!1,n~p1) f3_P
  dephosphorylate_docked_Ptc1_p1: Ptc1(dock!1,cat!2).Ste5(dock!1,cat!2,n~p1) -> \
    Ptc1(dock!1,cat).Ste5(dock!1,cat,n~p0) k_P
  dephosphorylate_site_only_Ptc1_p1: Ptc1(dock,cat!1).Ste5(dock,cat!1,n~p1) -> \
    Ptc1(dock,cat)+Ste5(dock,cat,n~p0) k_P
  bind_active_Fus3_p0: Fus3a(cat)+Ste5(dock,cat,n~p0) -> Fus3a(cat!1).Ste5(dock,cat!1,n~p0) 1*f4_K
  release_active_Fus3_p0: Fus3a(cat!1).Ste5(dock,cat!1,n~p0) -> Fus3a(cat)+Ste5(dock,cat,n~p0) b6_K
  phosphorylate_active_Fus3_p0: Fus3a(cat!1).Ste5(dock,cat!1,n~p0) -> \
    Fus3a(cat)+Ste5(dock,cat,n~p1) k_K

end reaction rules

end model

begin actions

  generate_network({overwrite=>1})  # 14 species, 23 reactions

  # Alpha-factor dose-response at steady state

  #@protocol: |
  #  Starting from unphosphorylated, unbound Ste5 at every scan point, vary
  #  alpha-factor from 0.001 to 10 uM (1 to 10000 nM), integrate the
  #  deterministic mass-action equations, and report mean Ste5
  #  phosphorylation together with Fus3-Ste5 and Ptc1-Ste5 complexes.

  #@figure: Fig. 3b in Malleshaiah et al. (2010)

  parameter_scan({method=>"ode",suffix=>"scan",parameter=>"alpha",\
    par_min=>1,par_max=>10000,n_scan_pts=>41,log_scale=>1,t_start=>0,\
    t_end=>100000,n_steps=>200,steady_state=>1,reset_conc=>1,\
    print_functions=>1,atol=>1e-10,rtol=>1e-8})

end actions
