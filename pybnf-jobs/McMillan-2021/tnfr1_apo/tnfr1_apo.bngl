begin model

#@title: TNF-TNFR1 sequential binding (McMillan et al., 2021)

#@description: |
#  Equilibrium binding of soluble human TNFR1 to the three sites of a trimeric
#  human TNF ligand, reconstructed from the BioNetGen model distributed with
#  McMillan et al. (2021). The affinity of a free site depends on whether zero,
#  one, or two receptors are already bound, giving three sequential microscopic
#  dissociation constants. With the apo-TNF Fig. 1b values, the first two
#  binding steps are tight and the third is about an order of magnitude weaker;
#  a receptor titration therefore shifts TNF through its 0R, 1R, 2R, and 3R
#  occupancy states. The model uses molecule counts in a 1 fL assay volume and
#  is simulated deterministically to reproduce the IMS-MS equilibrium titration.

#@keyword: |
#  receptor-ligand binding, tumor necrosis factor, TNFR1, sequential binding,
#  negative cooperativity, ion-mobility mass spectrometry, mass action,
#  equilibrium titration, Homo sapiens

#@reference: |
#  McMillan D, Martinez-Fleites C, Porter J, Fox D 3rd, Davis R, Mori P, et al.
#  (2021). Structural insights into the disruption of TNF-TNFR1 signalling by
#  small molecules stabilising a distorted TNF. Nat Commun 12:582.
#  doi:10.1038/s41467-020-20828-3

#@note: |
#  The three TNF sites are structurally identical but explicitly named so the
#  occupancy-dependent affinities in the authors' Supplementary Software 1 can
#  be represented without changing their rule semantics. Kd_1, Kd_2, and Kd_3
#  are single-free-site constants for the first, second, and third binding
#  events, respectively. Each explicit site rule therefore uses the published
#  constant directly; the generated network supplies occupancy multiplicity.

begin parameters
  # Avogadro constant (exact)
  NA 6.02214076e23 # molecules/mol

  # Assay volume used by McMillan et al. (2021), Supplementary Software 1
  V_ref 1e-15 # L/assay

  # Initial trimeric TNF concentration in the Fig. 1b IMS-MS titration
  TNF_conc 5000 # nM
  # Initial soluble TNFR1 concentration; scanned over the Fig. 1b doses
  TNFR1_conc 1000 # nM

  # Population equivalents in the assay volume
  TNF_total TNF_conc*1e-9*NA*V_ref # molecules
  TNFR1_total TNFR1_conc*1e-9*NA*V_ref # molecules

  # Common dissociation rate used by the authors' supplied model
  koff 0.01 # /s

  # Apo-TNF sequential dissociation constants reported in Fig. 1b
  Kd_1 0.01 # nM
  Kd_2 0.02 # nM
  Kd_3 0.22 # nM

  # Association rates converted to population units
  kon_1 koff/(Kd_1*1e-9*NA*V_ref) # /(molecule/assay)/s
  kon_2 koff/(Kd_2*1e-9*NA*V_ref) # /(molecule/assay)/s
  kon_3 koff/(Kd_3*1e-9*NA*V_ref) # /(molecule/assay)/s
end parameters

begin molecule types
  # Trimeric TNF represented as one molecule with three receptor-binding sites
  TNF(s1,s2,s3)
  # Soluble human TNFR1 ectodomain
  TNFR1(tnf)
end molecule types

begin seed species
  # Free TNF trimers
  TNF(s1,s2,s3) TNF_total # molecules
  # Free soluble TNFR1
  TNFR1(tnf) TNFR1_total # molecules
end seed species

begin observables
  # Total TNF trimers across all receptor occupancies
  Molecules TNF_all TNF()
  # TNF trimers with no receptor bound
  Species TNF_0R TNF(s1,s2,s3)
  # TNF trimers with exactly one receptor bound
  Species TNF_1R TNF(s1!+,s2,s3),TNF(s1,s2!+,s3),TNF(s1,s2,s3!+)
  # TNF trimers with exactly two receptors bound
  Species TNF_2R TNF(s1!+,s2!+,s3),TNF(s1!+,s2,s3!+),TNF(s1,s2!+,s3!+)
  # TNF trimers with all three receptors bound
  Species TNF_3R TNF(s1!+,s2!+,s3!+)
  # Total receptor molecules bound to TNF
  Molecules TNFR1_bound TNFR1(tnf!+)
end observables

begin functions
  # IMS-MS readouts: molar fractions of TNF occupancy states
  Frac_TNF_0R() TNF_0R/TNF_all
  Frac_TNF_1R() TNF_1R/TNF_all
  Frac_TNF_2R() TNF_2R/TNF_all
  Frac_TNF_3R() TNF_3R/TNF_all

  # Dimensional conversions (uncomment for concentration output)
# TNF_all_conc() = TNF_all/(NA*V_ref) # M
# TNF_0R_conc() = TNF_0R/(NA*V_ref) # M
# TNF_1R_conc() = TNF_1R/(NA*V_ref) # M
# TNF_2R_conc() = TNF_2R/(NA*V_ref) # M
# TNF_3R_conc() = TNF_3R/(NA*V_ref) # M
# TNFR1_bound_conc() = TNFR1_bound/(NA*V_ref) # M
end functions

begin reaction rules
  # First receptor-binding event: any one of the three free TNF sites
  R_bind_1_s1: TNF(s1,s2,s3)+TNFR1(tnf)<->\
    TNF(s1!1,s2,s3).TNFR1(tnf!1) kon_1,koff
  R_bind_1_s2: TNF(s1,s2,s3)+TNFR1(tnf)<->\
    TNF(s1,s2!1,s3).TNFR1(tnf!1) kon_1,koff
  R_bind_1_s3: TNF(s1,s2,s3)+TNFR1(tnf)<->\
    TNF(s1,s2,s3!1).TNFR1(tnf!1) kon_1,koff

  # Second receptor-binding event: either remaining site on a 1R complex
  R_bind_2_s1_s2: TNF(s1!+,s2,s3)+TNFR1(tnf)<->\
    TNF(s1!+,s2!1,s3).TNFR1(tnf!1) kon_2,koff
  R_bind_2_s1_s3: TNF(s1!+,s2,s3)+TNFR1(tnf)<->\
    TNF(s1!+,s2,s3!1).TNFR1(tnf!1) kon_2,koff
  R_bind_2_s2_s1: TNF(s1,s2!+,s3)+TNFR1(tnf)<->\
    TNF(s1!1,s2!+,s3).TNFR1(tnf!1) kon_2,koff
  R_bind_2_s2_s3: TNF(s1,s2!+,s3)+TNFR1(tnf)<->\
    TNF(s1,s2!+,s3!1).TNFR1(tnf!1) kon_2,koff
  R_bind_2_s3_s1: TNF(s1,s2,s3!+)+TNFR1(tnf)<->\
    TNF(s1!1,s2,s3!+).TNFR1(tnf!1) kon_2,koff
  R_bind_2_s3_s2: TNF(s1,s2,s3!+)+TNFR1(tnf)<->\
    TNF(s1,s2!1,s3!+).TNFR1(tnf!1) kon_2,koff

  # Third receptor-binding event: the last free site on a 2R complex
  R_bind_3_s3: TNF(s1!+,s2!+,s3)+TNFR1(tnf)<->\
    TNF(s1!+,s2!+,s3!1).TNFR1(tnf!1) kon_3,koff
  R_bind_3_s2: TNF(s1!+,s2,s3!+)+TNFR1(tnf)<->\
    TNF(s1!+,s2!1,s3!+).TNFR1(tnf!1) kon_3,koff
  R_bind_3_s1: TNF(s1,s2!+,s3!+)+TNFR1(tnf)<->\
    TNF(s1!1,s2!+,s3!+).TNFR1(tnf!1) kon_3,koff
end reaction rules

end model
